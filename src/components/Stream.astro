---
import Block from './Block.astro';
import type { Post } from '../lib/load';

interface Props {
  posts: Post[];
  things: Map<string, string>;
  lane?: 'all' | 'photos' | 'longreads' | 'notes';
  current?: string; // id of the post open on the left
  older?: string; // href of the next page, when there is one
  newer?: string;
}

const { posts, things, lane = 'all', current, older, newer } = Astro.props;
const lanes: { id: NonNullable<Props['lane']>; href: string }[] = [
  { id: 'all', href: '/stream' },
  { id: 'photos', href: '/photos' },
  { id: 'longreads', href: '/longreads' },
  { id: 'notes', href: '/notes' },
];
---

<section class="stream" data-stream>
  <nav class="lanes small">
    {lanes.map((l) => (
      <a href={l.href} data-lane={l.id} class:list={[{ on: l.id === lane }]}>
        {l.id}
      </a>
    ))}
  </nav>
  {posts.length === 0 && <p class="empty small">Nothing here yet.</p>}
  {posts.map((p) => <Block post={p} things={things} current={p.id === current} />)}
  <p class="empty filtered small" hidden>Nothing of that kind here.</p>
  {
    (older || newer) && (
      <nav class="pages small">
        {newer && <a href={newer}>newer</a>}
        {older && <a href={older}>older</a>}
      </nav>
    )
  }
</section>

<script>
  // The lane row filters the feed in place, so the left side stays where it is.
  // The links still work as links (the lane pages) when this does not run.
  const LANES = ['all', 'photos', 'longreads', 'notes'];
  for (const stream of document.querySelectorAll<HTMLElement>('[data-stream]')) {
    const blocks = Array.from(stream.querySelectorAll<HTMLElement>('.block[data-lane]'));
    const links = Array.from(stream.querySelectorAll<HTMLAnchorElement>('.lanes a[data-lane]'));
    const empty = stream.querySelector<HTMLElement>('.empty.filtered');
    const apply = (lane: string, month?: string) => {
      let shown = 0;
      for (const b of blocks) {
        const hide = (lane !== 'all' && b.dataset.lane !== lane) || (!!month && b.dataset.month !== month);
        b.hidden = hide;
        if (!hide) shown++;
      }
      for (const a of links) a.classList.toggle('on', a.dataset.lane === lane);
      if (empty) empty.hidden = shown > 0;
    };
    for (const a of links) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const lane = a.dataset.lane ?? 'all';
        apply(lane);
        history.replaceState(null, '', lane === 'all' ? location.pathname : `#${lane}`);
      });
    }
    // Month links elsewhere on the page (the archive index) filter the same feed.
    for (const m of document.querySelectorAll<HTMLAnchorElement>('a[data-month]')) {
      m.addEventListener('click', (e) => {
        e.preventDefault();
        const month = m.dataset.month;
        const on = m.classList.contains('on');
        for (const x of document.querySelectorAll('a[data-month]')) x.classList.remove('on');
        if (!on) m.classList.add('on');
        apply('all', on ? undefined : month);
        history.replaceState(null, '', on ? location.pathname : `#${month}`);
      });
    }
    const h = location.hash.slice(1);
    if (LANES.includes(h)) apply(h);
    else if (/^\d{4}-\d\d$/.test(h)) {
      document.querySelector(`a[data-month="${h}"]`)?.classList.add('on');
      apply('all', h);
    }
  }
</script>

<style>
  .lanes {
    display: flex;
    gap: 1rem;
    padding: 20px 0 12px;
    border-bottom: 1px solid var(--line);
  }
  .lanes a { text-decoration: none; color: var(--ink-2); }
  .lanes a.on, .lanes a:hover { color: var(--ink); }

  .empty { padding: 2rem 0; }

  .pages { display: flex; gap: 1rem; padding: 1rem 0; }
</style>
