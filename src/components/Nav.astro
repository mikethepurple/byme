---
// The right pane: navigation only, the same on every page. Three filter rows of
// one shape — project, kind, when — each with its own "all" first, and they
// combine (Ada's photos in October). All three on "all" is everything. A
// project's name is plain; it takes the project's colour when marked or
// hovered — the colour the cells and the project head carry on the number.
import type { Post, Thing, Scope } from '../lib/load';

interface Props {
  things: Thing[];
  posts: Post[]; // all posts, for the When row
  scope?: Scope; // what is in force
  where?: 'front' | 'browse' | 'post'; // the rows mark only while browsing
}

const { things, posts, scope = {}, where = 'browse' } = Astro.props;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const months = Array.from(new Set(posts.map((p) => p.data.date.slice(0, 7)))).sort().reverse();
const years = Array.from(new Set(months.map((m) => m.slice(0, 4))));

const marks = where === 'browse';
const { thing, lane, month } = scope;
// An address is /<project>/<month>/<kind>, each part optional; none at all is /everything.
const at = (t?: string, m?: string, l?: string) => `${t ? `/${t}` : ''}${m ? `/${m}` : ''}${l ? `/${l}` : ''}` || '/everything';
const tint = (c: string) => `--c: ${c}`;
---

<div class="brand-row">
  <a href="/" class="brand"><span class="dot"></span>by.erikov.me</a>
</div>

<nav id="nav" class="nav">
  <div class="filter">
    <span class="k small">project</span>
    <span class="options">
      <a href={at(undefined, month, lane)} class:list={[{ on: marks && !thing }]}>all</a>
      {
        things.map((t) => (
          <a href={at(t.id, month, lane)} class:list={['project', { on: marks && thing === t.id, tint: !!t.data.color }]} style={t.data.color ? tint(t.data.color) : undefined}>
            {t.data.name}
          </a>
        ))
      }
    </span>
  </div>
  <div class="filter">
    <span class="k small">kind</span>
    <span class="options">
      <a href={at(thing, month)} class:list={[{ on: marks && !lane }]}>all</a>
      {(['photos', 'longreads', 'notes'] as const).map((l) => <a href={at(thing, month, l)} class:list={[{ on: marks && lane === l }]}>{l}</a>)}
    </span>
  </div>
  <div class="filter">
    <span class="k small">when</span>
    <span class="options">
      <a href={at(thing, undefined, lane)} class:list={[{ on: marks && !month }]}>all</a>
      {
        years.map((y) => (
          <>
            <a href={at(thing, y, lane)} class:list={['year', { on: marks && y === month }]}>{y}</a>
            {months
              .filter((m) => m.startsWith(y))
              .map((m) => (
                <a href={at(thing, m, lane)} class:list={[{ on: marks && m === month }]}>{MONTHS[+m.slice(5, 7) - 1]}</a>
              ))}
          </>
        ))
      }
    </span>
  </div>

  <div class="foot small">
    <a href="/rss.xml">rss</a>
    <button type="button" class="theme-toggle" aria-label="Switch between light and dark">dark</button>
  </div>
</nav>

<style>
  .brand-row { padding: 14px var(--page-pad); border-bottom: 1px solid var(--line); }
  .brand { display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; font-weight: 500; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }

  /* one row per axis: its name in the left column, the options after */
  .filter {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 14px var(--page-pad);
    border-bottom: 1px solid var(--line);
  }
  .filter .k { color: var(--ink-3); }
  /* every row starts with "all", so the options line up across the rows */
  .options { display: flex; flex-wrap: wrap; gap: 0.35rem 1.25rem; }
  .options a { color: var(--ink-2); text-decoration: none; white-space: nowrap; }
  .options a:hover { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  .options a.on { color: var(--accent-ink); }

  /* a project: marked and underlined in its own colour (more specific than
     the amber mark above) */
  .options a.project.tint:hover { text-decoration-color: color-mix(in oklab, var(--c) var(--tint-mix), #000); }
  .options a.project.tint.on { color: color-mix(in oklab, var(--c) var(--tint-mix), #000); }

  .foot { display: flex; gap: 1rem; padding: 12px var(--page-pad); border-bottom: 1px solid var(--line); }
  .foot a, .theme-toggle { color: var(--ink-3); text-decoration: none; }
  .foot a:hover, .theme-toggle:hover { color: var(--ink); }
  .theme-toggle { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
</style>
