---
// The right pane: one ruled row saying what the feed shows and the kind tabs,
// then the feed. When a post is open it sits above with its facts (a ruled
// key/value table); the feed of its scope continues below.
import Block from './Block.astro';
import type { Post } from '../lib/load';

export interface Row {
  key: string;
  value?: string;
  href?: string;
  links?: { label: string; href: string }[];
}

interface Props {
  label?: string; // a plain row above the feed, e.g. "more in Ada" under an open post
  posts: Post[];
  things: Map<string, string>;
  older?: string;
  newer?: string;
  rows?: Row[];
}

const { label, posts, things, older, newer, rows = [] } = Astro.props;
---

{
  rows.length > 0 && (
    <dl class="rows small">
      {rows.map((r) => (
        <div class="row">
          <dt>{r.key}</dt>
          <dd>
            {r.links ? (
              r.links.map((l, i) => (
                <>
                  {i > 0 && <span class="sep"> · </span>}
                  <a href={l.href}>{l.label}</a>
                </>
              ))
            ) : r.href ? (
              <a href={r.href}>{r.value}</a>
            ) : (
              r.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  )
}

<slot />

{label && <div class="scope small">{label}</div>}

{posts.length === 0 && <p class="empty small">Nothing here yet.</p>}
{posts.map((p) => <Block post={p} things={things} />)}

{
  (older || newer) && (
    <nav class="pages small">
      {newer && <a href={newer}>newer</a>}
      {older && <a href={older}>older</a>}
    </nav>
  )
}

<style>
  .rows { margin: 0; padding: 6px 0 0; }
  .row {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 8px var(--page-pad);
    border-bottom: 1px solid var(--line);
  }
  dt { color: var(--ink-3); margin: 0; }
  dd { margin: 0; color: var(--ink); overflow-wrap: anywhere; }
  dd a { color: var(--ink); text-decoration: none; }
  dd a:hover { text-decoration: underline; }
  .sep { color: var(--ink-3); }

  .scope {
    padding: 14px var(--page-pad) 12px;
    border-bottom: 1px solid var(--line);
    color: var(--ink-2);
  }

  .empty { padding: 2rem var(--page-pad); }

  .pages { display: flex; gap: 1rem; padding: 1rem var(--page-pad); }
</style>
