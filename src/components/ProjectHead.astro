---
// The top of a project page: number, name, the one line, where to try it, a
// small picture. Its posts follow as a grid.
import { Image } from 'astro:assets';
import type { Thing } from '../lib/load';

interface Props {
  thing: Thing;
  index: number;
}

const { thing, index } = Astro.props;
---

<header class="head">
  <div class="text">
    <span class="n small">{String(index).padStart(2, '0')}</span>
    <h1 class="name" transition:name={`thing-${thing.id}`}>{thing.data.name}</h1>
    {thing.data.line && <p class="line">{thing.data.line}</p>}
    {
      thing.data.try.length > 0 && (
        <p class="try">
          {thing.data.try.map((l) => (
            <a href={l.url}>{l.label}</a>
          ))}
        </p>
      )
    }
  </div>
  {
    thing.data.cover && (
      <div class="cover">
        <Image src={thing.data.cover} alt="" widths={[480, 960]} sizes="(max-width: 900px) 50vw, 22vw" />
      </div>
    )
  }
</header>

<style>
  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26%);
    gap: 24px;
    align-items: end;
    padding: 28px var(--pad-wide) 28px;
  }
  .n { color: var(--ink-3); }
  .name {
    font-size: clamp(2.5rem, 7cqw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0.4rem 0 0;
  }
  .line { max-width: 44ch; margin: 1rem 0 0; color: var(--ink-2); font-size: 1.0625rem; }
  .try { display: flex; gap: 1.25rem; margin: 0.75rem 0 0; }
  .cover { justify-self: end; width: 100%; }
  .cover :global(img) { width: 100%; height: auto; }

  @container pane (max-width: 640px) {
    .head { grid-template-columns: minmax(0, 1fr); align-items: start; }
    .cover { width: 50%; }
  }
</style>
