---
// The top of a project page: number (in the project's colour), name, the one
// line, where to try it; the name in the project's colour. No picture: the
// posts underneath are the pictures.
// The column's kind and when rows narrow them.
import type { Thing } from '../lib/load';

interface Props {
  thing: Thing;
  index: number;
}

const { thing, index } = Astro.props;
---

<header class:list={['head', { tint: !!thing.data.color }]} style={thing.data.color ? `--c: ${thing.data.color}` : undefined}>
  <div class="text">
    <span class:list={['n', 'small', { tint: !!thing.data.color }]} style={thing.data.color ? `--c: ${thing.data.color}` : undefined}>
      {String(index).padStart(2, '0')}
    </span>
    <h1 class="name" transition:name={`thing-${thing.id}`}>{thing.data.name}</h1>
    {thing.data.line && <p class="line">{thing.data.line}</p>}
    {
      thing.data.try.length > 0 && (
        <p class="try">
          {thing.data.try.map((l) => (
            <a href={l.url}>{l.label}</a>
          ))}
        </p>
      )
    }
  </div>
</header>

<style>
  .head {
    padding: 28px var(--page-pad) 28px; /* the cells' padding, so the head's edges line up with theirs */
  }
  .n { color: var(--ink-3); }
  .n.tint { font-weight: 500; color: color-mix(in oklab, var(--c) var(--tint-mix), #000); }
  .head.tint .name { color: color-mix(in oklab, var(--c) var(--tint-mix), #000); }
  .name {
    font-size: clamp(2.5rem, 7cqw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0.4rem 0 0;
  }
  .line { max-width: 44ch; margin: 1rem 0 0; color: var(--ink-2); font-size: 1.0625rem; }
  .try { display: flex; gap: 1.25rem; margin: 0.75rem 0 0; }
</style>
