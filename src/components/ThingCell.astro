---
// One cell of the index grid: the number and name do the work; the picture is
// small and uncropped, parked in the corner. No picture is a fine cell too.
// `on` marks the project whose posts the feed is showing.
import { Image } from 'astro:assets';
import type { Thing } from '../lib/load';

interface Props {
  thing: Thing;
  index: number;
  on?: boolean;
}

const { thing, index, on = false } = Astro.props;
const n = String(index).padStart(2, '0');
---

<a href={`/${thing.id}`} class:list={['cell', { on }]}>
  <div class="head">
    <span class="n small">{n}</span>
    <span class="name" transition:name={`thing-${thing.id}`}>{thing.data.name}</span>
  </div>
  <p class="line small">{thing.data.line}</p>
  {
    thing.data.cover && (
      <div class="pic" transition:name={`thing-${thing.id}-pic`}>
        <Image src={thing.data.cover} alt={thing.data.name} widths={[320, 640]} sizes="(max-width: 900px) 45vw, 24vw" />
      </div>
    )
  }
</a>

<style>
  .cell {
    container-type: inline-size;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
    padding: 20px var(--page-pad) 20px;
    min-height: 0;
  }

  .cell:hover .name, .cell.on .name {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .cell.on .n { color: var(--accent); }

  .head {
    display: flex;
    align-items: baseline;
    gap: 1rem;
  }

  .n { color: var(--ink-3); }

  .name {
    /* sized by the cell, so a 2-up grid in a narrow pane never clips a name */
    font-size: clamp(1.75rem, 15cqw, 4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .line { max-width: 32ch; margin: 0; }

  .pic {
    position: absolute;
    right: var(--page-pad);
    bottom: 20px;
    width: 36%;
    max-width: 320px;
  }

  .pic :global(img) { width: 100%; height: auto; display: block; }

  @media (max-width: 900px) {
    .pic { position: static; width: 45%; margin-top: 0.75rem; }
  }
</style>
