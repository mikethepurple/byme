---
// A ruled grid of cells, as many across as the pane allows. Lines come from
// each cell's top and left edge; the grid is shifted one pixel up and left so
// the outer ones fall off, and an empty slot in the last row stays bare.
import Cell from './Cell.astro';
import type { Item } from '../lib/load';

interface Props {
  items: Item[];
  names: Map<string, string>;
}

const { items, names } = Astro.props;
---

{items.length === 0 && <p class="empty small">Nothing here yet.</p>}
{
  items.length > 0 && (
    <div class="grid">
      {items.map((it) => (it.kind === 'thing' ? <Cell thing={it.thing} index={it.index} /> : <Cell post={it.post} names={names} />))}
    </div>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    margin: -1px 0 0 -1px;
    border-bottom: 1px solid var(--line);
  }
  .empty { padding: 2rem var(--page-pad); }
</style>
