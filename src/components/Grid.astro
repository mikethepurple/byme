---
// A ruled grid of cells, as many across as the pane allows. Each cell draws its
// right and bottom edge, the grid its top edge; the grid is one pixel wider than
// the pane so the last column's edge falls off. An empty slot in the last row
// is ruled above and on its left by its neighbours, open below.
import Cell from './Cell.astro';
import type { Post, Thing } from '../lib/load';

interface Props {
  things?: Thing[]; // the projects, first, on the front
  posts: Post[];
  names: Map<string, string>;
  colors?: Map<string, string>;
}

const { things = [], posts, names, colors = new Map() } = Astro.props;
---

{things.length + posts.length === 0 && <p class="empty small">Nothing here yet.</p>}
{
  things.length + posts.length > 0 && (
    <div class="grid">
      {things.map((thing, i) => <Cell thing={thing} index={i + 1} />)}
      {posts.map((post) => <Cell post={post} names={names} colors={colors} />)}
    </div>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    width: calc(100% + 1px);
    border-top: 1px solid var(--line);
  }
  .empty { padding: 2rem var(--page-pad); }
</style>
