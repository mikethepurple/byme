---
// A ruled grid of cells, as many across as the pane allows. Each cell draws its
// right and bottom edge, the grid its top edge; the grid is one pixel wider than
// the pane so the last column's edge falls off. An empty slot in the last row
// is ruled above and on its left by its neighbours, open below.
import Cell from './Cell.astro';
import type { Item } from '../lib/load';

interface Props {
  items: Item[];
  names: Map<string, string>;
  colors?: Map<string, string>;
}

const { items, names, colors = new Map() } = Astro.props;
---

{items.length === 0 && <p class="empty small">Nothing here yet.</p>}
{
  items.length > 0 && (
    <div class="grid">
      {items.map((it) => (it.kind === 'thing' ? <Cell thing={it.thing} index={it.index} /> : <Cell post={it.post} names={names} colors={colors} />))}
    </div>
  )
}

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    width: calc(100% + 1px);
    border-top: 1px solid var(--line);
  }
  .empty { padding: 2rem var(--page-pad); }
</style>
