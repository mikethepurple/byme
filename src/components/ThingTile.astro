---
import { Image } from 'astro:assets';
import type { Thing } from '../lib/load';

interface Props {
  thing: Thing;
}

const { thing } = Astro.props;
---

<a href={`/${thing.id}`} class="tile">
  <div class="square">
    {
      thing.data.cover ? (
        <Image
          src={thing.data.cover}
          alt={thing.data.name}
          widths={[400, 800]}
          sizes="(max-width: 900px) 50vw, 320px"
        />
      ) : (
        <span class="word">{thing.data.name}</span>
      )
    }
  </div>
  <div class="caption">
    <span class="name">{thing.data.name}</span>
    <span class="line small">{thing.data.line}</span>
  </div>
</a>

<style>
  .tile {
    display: block;
    text-decoration: none;
    color: var(--ink);
  }

  .square {
    aspect-ratio: 1 / 1;
    border: 1px solid var(--line);
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--bg);
  }

  .square :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile:hover .square { border-color: var(--ink-3); }

  .word {
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .caption {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0 0;
  }

  .name { font-weight: 500; }
  .line { color: var(--ink-2); }
</style>
