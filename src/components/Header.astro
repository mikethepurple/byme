---
// One ruled row on every page: the name (home) and the feed address.
---

<header class="header">
  <div class="row">
    <a href="/" class="brand">
      <span class="dot"></span>
      <span class="name">by.erikov.me</span>
    </a>
    <nav class="nav small">
      <a href="/rss.xml">rss</a>
    </nav>
  </div>
</header>

<style>
  .header { border-bottom: 1px solid var(--line); }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px var(--page-pad);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .name { font-size: 0.95rem; font-weight: 500; }

  .nav a { text-decoration: none; color: var(--ink-2); }
  .nav a:hover { color: var(--ink); }
</style>
