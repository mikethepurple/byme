---
// One ruled row, split like the panes under it. Left: the name (home).
// Right: the menu stripe for the feed — where you are (everything › Ada),
// the kind tabs, and rss.
import type { Lane } from '../lib/load';

interface Props {
  split?: 'front' | 'feed';
  label?: string; // "everything", "Ada", "October 2026"
  root?: string; // when narrowed: where "everything" goes
  base?: string; // where the tabs live: '' (everything), '/ada', '/2026-10'
  allHref?: string; // where the "all" tab goes when there is no base
  lane?: Lane;
}
const { split = 'feed', label = 'everything', root, base = '', allHref = '/everything', lane } = Astro.props;
const tabs: { id: Lane | 'all'; href: string }[] = [
  { id: 'all', href: base || allHref },
  { id: 'photos', href: `${base}/photos` },
  { id: 'longreads', href: `${base}/longreads` },
  { id: 'notes', href: `${base}/notes` },
];
---

<header class:list={['header', split]}>
  <div class="cell">
    <a href="/" class="brand">
      <span class="dot"></span>
      <span class="name">by.erikov.me</span>
    </a>
  </div>
  <div class="cell right small">
    <span class="what">
      {root ? (
        <>
          <a href={root} class="up">everything</a>
          <span class="sep"> › </span>
          {label}
        </>
      ) : (
        label
      )}
    </span>
    <nav class="tabs">
      {tabs.map((t) => (
        <a href={t.href} class:list={[{ on: t.id === 'all' ? !lane : t.id === lane }]}>
          {t.id}
        </a>
      ))}
      <a href="/rss.xml" class="rss">rss</a>
    </nav>
  </div>
</header>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1px;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }
  .header.front { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }

  .cell {
    background: var(--bg);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 14px var(--page-pad);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .name { font-size: 0.95rem; font-weight: 500; }

  .what { color: var(--ink); }
  .what .up { color: var(--ink-2); text-decoration: none; }
  .what .up:hover { color: var(--ink); text-decoration: underline; }
  .sep { color: var(--ink-3); }

  .tabs { display: flex; gap: 1rem; }
  .tabs a { color: var(--ink-2); text-decoration: none; }
  .tabs a:hover { color: var(--ink); }
  .tabs a.on { color: var(--accent); }
  .tabs .rss { margin-left: 0.5rem; }

  @media (max-width: 900px) {
    .header, .header.front { grid-template-columns: minmax(0, 1fr); }
  }
</style>
