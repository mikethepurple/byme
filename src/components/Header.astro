---
// The header is a ruled row split the same way as the panes under it, so each
// column carries its own small caption, like a table head.
interface Props {
  split?: 'front' | 'feed';
}
const { split = 'feed' } = Astro.props;
---

<header class:list={['header', split]}>
  <div class="cell">
    <a href="/" class="brand">
      <span class="dot"></span>
      <span class="name">by.erikov.me</span>
    </a>
  </div>
  <div class="cell right">
    <span class="cap">the feed, newest first</span>
    <a href="/rss.xml" class="rss small">rss</a>
  </div>
</header>

<style>
  .header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1px;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }
  .header.front { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }

  .cell {
    background: var(--bg);
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 14px var(--page-pad);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--ink);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
    flex-shrink: 0;
  }

  .name { font-size: 0.95rem; font-weight: 500; }

  .cap {
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .rss { color: var(--ink-2); text-decoration: none; }
  .rss:hover { color: var(--ink); }

  @media (max-width: 900px) {
    .header { grid-template-columns: minmax(0, 1fr); }
    .cell.right { display: none; }
    .cell .cap { display: none; }
  }
</style>
