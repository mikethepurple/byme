---
// One cell of the grid, the hand-over's Cell: a project card or a post, 380px
// tall, every value as in the HTML.
//
// Project: "Project" and the index in the project's colour; a ledger — an ink
// rule, always four rows (kind | title | date), blank rows as hairlines, a
// footer "{n} posts · all →" in the colour; the name (56/600), a description
// with room for two lines, a link row that is always 30px. The name is the
// inward link, stretched over the card; the ↗ link is separate and above it.
// A heavier line under the card sets the project row apart (FIXES.md §6, 9d).
//
// Post: "Kind · Project" (misc in gray), the date on the right; a picture, or
// the title (20/500) and an excerpt of about 300 characters.
import { Image } from 'astro:assets';
import { formatShort, laneOf } from '../lib/posts';
import { KIND_LABEL, MISC, excerpt, ledger, projectOf, titleOf, stackEdges } from '../lib/related';
import { MISC_HUE, hueStyle, type Hue, type Post, type Thing } from '../lib/load';

interface Props {
  thing?: Thing;
  index?: number; // the project's number, 1-based
  theirs?: Post[]; // the project's posts, newest first
  post?: Post;
  names?: Map<string, string>;
  hues?: Map<string, Hue>;
  showProject?: boolean; // off on a project page
}

const { thing, index = 0, theirs = [], post, names = new Map(), hues = new Map(), showProject = true } = Astro.props;

const thingHue: Hue | undefined = thing ? (thing.data.color ? { c: thing.data.color, cd: thing.data.colorDark || thing.data.color } : MISC_HUE) : undefined;
const rows = thing ? ledger(theirs, 3) : [];
const edges = stackEdges(theirs.length);
// Version A (tinted tab) or B (ink only), chosen at build time for the A/B previews.
const tab = (import.meta.env.PUBLIC_DESIGN ?? 'b') === 'a';
const count = theirs.length;

const imgs = post?.data.images ?? [];
const proj = post ? projectOf(post) : '';
const projName = proj === MISC ? 'misc' : (names.get(proj) ?? proj);
const projHue = proj === MISC ? MISC_HUE : hues.get(proj);
const postText = post ? excerpt(post.plain, 300) : '';
const aria = post ? `${titleOf(post, 80)}, ${formatShort(post.data.date)}` : '';
---

{
  thing && (
    <article class:list={['cell', 'project', 'proj', { tab, none: count === 0 }]} style={hueStyle(thingHue)}>
      <div class="frame">
        <div class="tabrow">
          <span>Project</span>
          <span class="c">{String(index).padStart(2, '0')}</span>
        </div>
        <a href={`/${thing.id}`} class="name" transition:name={`thing-${thing.id}`} aria-label={`${thing.data.name}: all posts`}>
          {thing.data.name}
        </a>
        <p class="desc">{thing.data.line}</p>
        <div class="grow"></div>
        <div class="ledger">
          {rows.map((r) => (
            <div class="lrow">
              <span class="quiet">{r.kind}</span>
              <span class="t">{r.title}</span>
              <span class="quiet">{r.date}</span>
            </div>
          ))}
          <div class="lfoot">
            <span class="c">{count ? `${count} post${count > 1 ? 's' : ''} · all →` : 'No posts yet'}</span>
            {thing.data.try[0] && (
              <a href={thing.data.try[0].url} class="ext">
                {thing.data.try[0].label} ↗
              </a>
            )}
          </div>
        </div>
      </div>
      <div class="stack" aria-hidden="true">
        {Array.from({ length: edges }).map((_, i) => <div class="edge" style={`margin: 0 ${(i + 1) * 3}px`} />)}
      </div>
    </article>
  )
}

{
  post && (
    <article class={`cell post kind-${post.kind}`} transition:name={`post-${post.id}`}>
      <div class="label-row">
        <span class="what">
          <a href={`/${laneOf(post.kind)}`}>{KIND_LABEL[post.kind]}</a>
          {showProject && (
            <>
              {' · '}
              <a href={`/${proj}`} class="who proj" style={hueStyle(projHue)}>
                {projName}
              </a>
            </>
          )}
        </span>
        <span class="quiet">{formatShort(post.data.date)}</span>
      </div>
      {imgs.length > 0 && (
        <div class="pic">
          <Image src={imgs[0]} alt={titleOf(post, 80)} widths={[480, 960]} sizes="(max-width: 699px) 100vw, (max-width: 1199px) 50vw, 30vw" loading="lazy" />
        </div>
      )}
      {imgs.length === 0 && (
        <>
          {post.title && <div class="title">{post.title}</div>}
          {postText && <div class="text">{postText}</div>}
          {!post.title && !postText && post.data.link && <div class="title">{post.data.link.replace(/^https?:\/\//, '')}</div>}
        </>
      )}
      <a href={`/${post.id}`} class="open" aria-label={aria}></a>
    </article>
  )
}

<style>
  .cell {
    position: relative;
    height: var(--cell);
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
    padding: 18px 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }
  .label-row { font-size: 13px; }
  .label-row a { color: inherit; text-decoration: none; position: relative; z-index: 1; }
  .label-row a:hover { text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .c, .label-row a.who { color: var(--pc); }
  .quiet { color: var(--quiet); }

  /* the project card: a framed stack (hand-over 18c / 14b) */
  .project { padding: 14px 14px 0; }
  .frame {
    height: 320px;
    flex-shrink: 0;
    box-sizing: border-box;
    border: 1px solid var(--ink);
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
  }
  .project.none .frame { border-style: dashed; border-color: var(--dash); }
  .tabrow { display: flex; justify-content: space-between; font-size: 13px; }
  .project.tab .tabrow {
    background: color-mix(in srgb, var(--pc) 8%, var(--bg));
    margin: -12px -14px 0;
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
  }
  .name {
    margin-top: 14px;
    font-size: 56px;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .name::after { content: ''; position: absolute; inset: 0; }
  /* hover: the headline's underline turns on; nothing else changes */
  .cell { cursor: pointer; }
  .name, .title { text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .name { text-underline-offset: 8px; }
  .cell:hover .name, .cell:hover .title { text-decoration-color: currentColor; }
  .desc { margin: 10px 0 0; font-size: 15px; line-height: 1.4; color: var(--ink-2); max-width: 290px; min-height: 42px; }
  .grow { flex: 1 1 auto; }
  .ledger { display: flex; flex-direction: column; border-top: 1px solid var(--frame); }
  .lrow {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: 10px;
    padding: 7px 0;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    line-height: 16px;
    min-height: 31px; /* an empty row is as tall as a full one, so ledgers line up */
    box-sizing: border-box;
  }
  .lrow .t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lfoot { display: flex; justify-content: space-between; padding: 7px 0 0; font-size: 13px; line-height: 16px; }
  .ext { position: relative; z-index: 1; color: var(--ink); }

  .stack { height: 32px; flex-shrink: 0; overflow: hidden; display: flex; flex-direction: column; }
  .edge { height: 3px; flex-shrink: 0; box-sizing: border-box; border: 1px solid var(--edge); border-top: none; }

  /* a post */
  .post { gap: 12px; }
  .pic { flex: 1 1 auto; min-height: 0; }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; filter: var(--photo); }
  .title { font-size: 20px; font-weight: 500; letter-spacing: -0.02em; }
  .text { font-size: 15px; color: var(--ink-2); line-height: 1.45; }
  .open { position: absolute; inset: 0; }
</style>
