---
// One cell of the grid, per the hand-over: a project card or a post. Every
// cell is the same height.
//
// A project card: "Project" and the index in the project's colour; a ledger —
// an ink rule, always four rows (kind | title | date), blank rows as hairlines,
// a footer "{n} posts · all →" in the colour; then the name, a description
// with room for two lines, and a link row that is always 30px tall, so the
// names line up across the row. The name is the inward link, stretched over
// the card; the ↗ link is separate and sits above it. No nested anchors.
//
// A post: "Kind · Project" (misc in gray), the date on the right; a picture,
// or the title and an excerpt — never the whole article.
import { Image } from 'astro:assets';
import { formatShort, laneOf } from '../lib/posts';
import { KIND_LABEL, MISC, excerpt, ledger, projectOf } from '../lib/related';
import type { Post, Thing } from '../lib/load';

interface Props {
  thing?: Thing;
  index?: number; // the project's number, 1-based
  theirs?: Post[]; // the project's posts, newest first
  post?: Post;
  names?: Map<string, string>;
  colors?: Map<string, string>; // thing id → its colour
  showProject?: boolean; // off on a project page
}

const { thing, index = 0, theirs = [], post, names = new Map(), colors = new Map(), showProject = true } = Astro.props;

const color = thing ? thing.data.color || 'var(--quiet)' : '';
const rows = thing ? ledger(theirs, 4) : [];
const count = theirs.length;

const imgs = post?.data.images ?? [];
const proj = post ? projectOf(post) : '';
const projName = proj === MISC ? 'misc' : (names.get(proj) ?? proj);
const projColor = proj === MISC ? 'var(--misc)' : colors.get(proj) || '';
const postText = post ? excerpt(post.plain, 300) : '';
const aria = post ? post.title || excerpt(post.plain.split('\n')[0] ?? '', 80) || `${KIND_LABEL[post.kind]}, ${formatShort(post.data.date)}` : '';
---

{
  thing && (
    <article class="cell project" style={`--c: ${color}`}>
      <div class="label-row">
        <span>Project</span>
        <span class="c">{String(index).padStart(2, '0')}</span>
      </div>
      <div class="ledger">
        {rows.map((r) => (
          <div class="lrow">
            <span class="quiet">{r.kind}</span>
            <span class="t">{r.title}</span>
            <span class="quiet">{r.date}</span>
          </div>
        ))}
        <div class="lfoot c">
          <span>{count ? `${count} post${count > 1 ? 's' : ''}` : 'No posts yet'}</span>
          {count > 0 && <span>all →</span>}
        </div>
      </div>
      <div class="grow"></div>
      <a href={`/${thing.id}`} class="name" transition:name={`thing-${thing.id}`} aria-label={`${thing.data.name}: all posts`}>
        {thing.data.name}
      </a>
      <p class="desc">{thing.data.line}</p>
      <div class="linkrow">
        {thing.data.try[0] && (
          <a href={thing.data.try[0].url} class="ext">
            {thing.data.try[0].label} ↗
          </a>
        )}
      </div>
    </article>
  )
}

{
  post && (
    <article class={`cell post kind-${post.kind}`} transition:name={`post-${post.id}`}>
      <div class="label-row">
        <span class="what">
          <a href={`/${laneOf(post.kind)}`}>{KIND_LABEL[post.kind]}</a>
          {showProject && (
            <>
              {' · '}
              <a href={`/${proj}`} class="who" style={projColor ? `color: color-mix(in oklab, ${projColor} var(--tint-mix), #000)` : undefined}>
                {projName}
              </a>
            </>
          )}
        </span>
        <span class="quiet">{formatShort(post.data.date)}</span>
      </div>
      {imgs.length > 0 && (
        <div class="pic">
          <Image src={imgs[0]} alt={post.title || (post.kind === 'set' ? `${imgs.length} pictures` : 'Picture')} widths={[480, 960]} sizes="(max-width: 699px) 100vw, (max-width: 1199px) 50vw, 30vw" loading="lazy" />
        </div>
      )}
      {imgs.length === 0 && (
        <>
          {post.title && <div class="title">{post.title}</div>}
          {postText && <div class="text">{postText}</div>}
          {!post.title && !postText && post.data.link && <div class="title">{post.data.link.replace(/^https?:\/\//, '')}</div>}
        </>
      )}
      <a href={`/${post.id}`} class="open" aria-label={aria}></a>
    </article>
  )
}

<style>
  .cell {
    position: relative;
    height: var(--cell);
    box-sizing: border-box;
    min-width: 0;
    overflow: hidden;
    padding: 18px var(--page-pad);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    color: var(--ink);
    display: flex;
    flex-direction: column;
  }
  .label-row a { color: inherit; text-decoration: none; position: relative; z-index: 1; }
  .label-row a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .c { color: color-mix(in oklab, var(--c) var(--tint-mix), #000); }

  /* the project card */
  .ledger { display: flex; flex-direction: column; margin-top: 14px; border-top: 1px solid var(--ink); }
  .lrow {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    gap: 10px;
    padding: 7px 0;
    height: 30px;
    box-sizing: border-box;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    line-height: 16px;
  }
  .lrow .t { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .lfoot { display: flex; justify-content: space-between; padding: 7px 0; font-size: 13px; line-height: 16px; }
  .grow { flex: 1 1 auto; }
  .name {
    font-size: 56px;
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1;
    color: var(--ink);
    text-decoration: none;
  }
  .name::after { content: ''; position: absolute; inset: 0; }
  .project:hover .name { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; text-decoration-color: color-mix(in oklab, var(--c) var(--tint-mix), #000); }
  .desc { margin: 14px 0 0; font-size: 15px; line-height: 1.4; color: var(--ink-2); max-width: 270px; min-height: 42px; }
  .linkrow { height: 30px; display: flex; align-items: flex-end; }
  .ext { position: relative; z-index: 1; font-size: 15px; color: var(--ink); text-decoration-color: var(--ink-3); }

  /* a post */
  .post { gap: 12px; }
  .pic { flex: 1 1 auto; min-height: 0; }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .title { font-size: 20px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.2; }
  .text { font-size: 15px; color: var(--ink-2); line-height: 1.45; }
  .open { position: absolute; inset: 0; }
  .post:hover .title { text-decoration: underline; text-underline-offset: 4px; }
</style>
