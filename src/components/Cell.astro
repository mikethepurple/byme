---
// One cell of a grid: a project, or a post of any kind. Every cell has the same
// shape: a label row on top saying what it is (Project, Photo, Set, Note,
// Longread) with the number or date on the right, then a box inside the same
// margins. Text is cut at the box's bottom; a picture fills the box, cropped;
// a set is a strip of such pictures you swipe through.
import { Image } from 'astro:assets';
import { formatShort } from '../lib/posts';
import type { Post, Thing } from '../lib/load';

interface Props {
  thing?: Thing;
  index?: number; // the project's number, 1-based
  post?: Post;
  names?: Map<string, string>;
}

const { thing, index = 0, post, names = new Map() } = Astro.props;
const imgs = post?.data.images ?? [];
const link = post?.data.link || '';
const hostOf = (u: string) => u.replace(/^https?:\/\//, '').replace(/\/$/, '');
const KIND = { photo: 'Photo', set: 'Set', note: 'Note', longread: 'Longread' } as const;
---

{
  thing && (
    <a href={`/${thing.id}`} class="cell thing">
      <div class="top">
        <span class="what">Project</span>
        <span class="when small">{String(index).padStart(2, '0')}</span>
      </div>
      <div class="box">
        <span class="name" transition:name={`thing-${thing.id}`}>{thing.data.name}</span>
        {thing.data.line && <p class="line">{thing.data.line}</p>}
      </div>
    </a>
  )
}

{
  post && (
    <a href={`/${post.id}`} class={`cell post kind-${post.kind}`} transition:name={`post-${post.id}`}>
      <div class="top">
        <span class="what">
          {KIND[post.kind]}
          {post.things.length > 0 && (
            <>
              <span class="sep"> · </span>
              <span class="who">{post.things.map((id) => names.get(id) ?? id).join(', ')}</span>
            </>
          )}
        </span>
        <span class="when small">{formatShort(post.data.date)}</span>
      </div>
      <div class="box">
        {imgs.length === 1 && (
          <div class="photo">
            <Image src={imgs[0]} alt={post.data.title || ''} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 33vw" loading="lazy" />
          </div>
        )}
        {imgs.length > 1 && (
          <div class="photo strip" data-strip>
            <div class="slides">
              {imgs.slice(0, 6).map((img) => (
                <div class="slide">
                  <Image src={img} alt="" widths={[480, 960]} sizes="(max-width: 900px) 100vw, 33vw" loading="lazy" />
                </div>
              ))}
            </div>
            <div class="dots">{imgs.slice(0, 6).map((_, i) => <i class:list={[{ on: i === 0 }]} />)}</div>
          </div>
        )}
        {imgs.length === 0 && (
          <div class="text">
            {post.data.title && <span class="title">{post.data.title}</span>}
            {link && !post.text && <span class="href">{hostOf(link)}</span>}
            {post.text && <span class="body">{post.plain}</span>}
          </div>
        )}
      </div>
    </a>
  )
}

<style>
  .cell {
    display: flex;
    flex-direction: column;
    aspect-ratio: 1 / 1;
    min-height: 0;
    background: var(--bg);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    container-type: inline-size;
  }

  /* the label row: what it is, and its number or date */
  .top {
    flex: none;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 12px var(--page-pad) 0;
  }
  .what { color: var(--ink); font-weight: 500; }
  .sep { color: var(--ink-3); font-weight: 400; }
  .who { color: var(--accent-ink); }
  .when { color: var(--ink-3); }
  .cell:hover .what { text-decoration: underline; text-decoration-color: var(--accent-ink); text-underline-offset: 4px; }

  /* the box: everything sits inside the same margins */
  .box {
    flex: 1 1 auto;
    min-height: 0;
    position: relative;
    margin: 12px var(--page-pad) var(--page-pad);
    overflow: hidden;
  }

  /* a project: its name and line, nothing else */
  .name {
    display: block;
    font-size: clamp(1.75rem, 13cqw, 3rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .cell:hover .name { text-decoration: underline; text-decoration-color: var(--accent-ink); text-decoration-thickness: 2px; text-underline-offset: 6px; }
  .line { margin: 0.75rem 0 0; max-width: 30ch; color: var(--ink-2); }

  /* a picture fills the box, cropped; a set is a strip of them */
  .photo { position: absolute; inset: 0; }
  .photo :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .slides {
    display: flex;
    height: 100%;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .slides::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; height: 100%; scroll-snap-align: start; }
  .dots { position: absolute; left: 0; right: 0; bottom: 8px; display: flex; justify-content: center; gap: 5px; pointer-events: none; }
  .dots i { width: 6px; height: 6px; border-radius: 50%; background: rgba(255, 255, 255, 0.5); box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.3); }
  .dots i.on { background: #fff; }

  /* text, cut at the box's bottom, fading out */
  .text {
    height: 100%;
    mask-image: linear-gradient(#000 70%, transparent 100%);
    -webkit-mask-image: linear-gradient(#000 70%, transparent 100%);
  }
  .title { display: block; font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; line-height: 1.25; margin-bottom: 0.5rem; }
  .body { display: block; white-space: pre-line; color: var(--ink-2); }
  .kind-longread .body { font-size: 0.9375rem; }
  .href { display: block; text-decoration: underline; text-decoration-color: var(--ink-3); text-underline-offset: 3px; }
</style>

<script>
  // A set's strip: the dot follows the picture in view. Runs once per page and
  // again after every in-place navigation.
  function wire() {
    document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
      const slides = strip.querySelector<HTMLElement>('.slides');
      if (!slides || slides.dataset.wired) return;
      slides.dataset.wired = '1';
      const dots = strip.querySelectorAll('.dots i');
      slides.addEventListener(
        'scroll',
        () => {
          const i = Math.round(slides.scrollLeft / slides.clientWidth);
          dots.forEach((d, k) => d.classList.toggle('on', k === i));
        },
        { passive: true },
      );
    });
  }
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
