---
interface Props {
  slug: string;
  title: string;
  date: string;
  description?: string;
}

const { slug, title, date, description } = Astro.props;

const formatted = new Date(date + 'T00:00:00').toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a href={`/${slug}`} class="post-card">
  <time datetime={date}>{formatted}</time>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
</a>

<style>
  .post-card {
    display: block;
    text-decoration: none;
    padding: 1.25rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--ink-4), transparent 70%);
    transition: padding-left 0.15s;
  }

  .post-card:hover {
    padding-left: 0.5rem;
  }

  time {
    font-size: 0.8rem;
    color: var(--ink-3);
    font-weight: 400;
  }

  h2 {
    font-size: 1.15rem;
    font-weight: 600;
    margin: 0.25rem 0 0;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  p {
    font-size: 0.9rem;
    color: var(--ink-2);
    margin: 0.35rem 0 0;
    line-height: 1.5;
  }
</style>
