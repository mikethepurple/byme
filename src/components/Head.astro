---
// The head of a project, post or about page, per the hand-over. Its top line
// has the logo row's padding and line-height (18px, 22px) so the hairlines
// meet across the column boundary. The big title sits on the floor; the
// description and the ↗ link share one baseline.
import { hueStyle, type Hue } from '../lib/load';

interface Props {
  left: { text: string; href?: string; hue?: Hue; quiet?: boolean }[]; // the top line's items
  right?: { text: string; hue?: Hue; quiet?: boolean };
  title?: string; // none: an untitled post with no text; the top line says what it is
  size?: 'page' | 'post'; // 96px or 72px
  description?: string;
  link?: { label: string; url: string };
  transitionName?: string;
  frame?: 'solid' | 'dashed'; // a project: framed, with its stack of edges under it
  edges?: number;
  hue?: Hue; // the tab's tint (version A)
}

const { left, right, title, size = 'page', description, link, transitionName, frame, edges = 0, hue } = Astro.props;
const design = import.meta.env.PUBLIC_DESIGN ?? 'b';
const tab = !!frame && design === 'a';
const line = !!frame && design === 'c'; // B with the line under the top row in the project colour
---

<div class:list={['wrap', { framed: !!frame, dashed: frame === 'dashed' }]}>
<div class:list={['frame', 'hued', { tab, tintline: line }]} style={hueStyle(hue)}>
<div class="top">
  <div class="items">
    {
      left.map((i) =>
        i.href ? (
          <a href={i.href} class:list={[{ quiet: i.quiet, proj: !!i.hue }]} style={hueStyle(i.hue)}>{i.text}</a>
        ) : (
          <span class:list={[{ quiet: i.quiet, proj: !!i.hue }]} style={hueStyle(i.hue)}>{i.text}</span>
        ),
      )
    }
  </div>
  {right && <span class:list={[{ quiet: right.quiet !== false && !right.hue, proj: !!right.hue }]} style={hueStyle(right.hue)}>{right.text}</span>}
</div>
{
  (title || description || link) && (
    <div class="body">
      {title && <h1 class:list={['title', size]} transition:name={transitionName}>{title}</h1>}
      {(description || link) && (
        <div class="line">
          {description && <p class="desc">{description}</p>}
          {link && <a href={link.url} class="ext">{link.label} ↗</a>}
        </div>
      )}
    </div>
  )
}
</div>
{
  frame && edges > 0 && (
    <div class="stack" aria-hidden="true">
      {Array.from({ length: edges }).map((_, i) => <div class="edge" style={`margin: 0 ${(i + 1) * 3}px`} />)}
    </div>
  )
}
</div>

<style>
  .wrap { flex: 1 1 auto; display: flex; flex-direction: column; }
  .frame { flex: 1 1 auto; display: flex; flex-direction: column; }
  .wrap.framed { padding: 14px 14px 0; }
  .wrap.framed .frame { border: 1px solid var(--frame); }
  .wrap.framed.dashed { padding-bottom: 14px; }
  .wrap.framed.dashed .frame { border-style: dashed; border-color: var(--dash); }
  .frame.tab .top { background: color-mix(in srgb, var(--pc) 8%, var(--bg)); }
  /* in a project frame the top row is thin, as on the cards */
  .wrap.framed .top { padding: 9px 14px; line-height: 16px; }
  .frame.tintline .top { border-bottom-color: var(--pc); }
  .stack { height: 32px; flex-shrink: 0; overflow: hidden; display: flex; flex-direction: column; }
  .edge { height: 3px; flex-shrink: 0; box-sizing: border-box; border: 1px solid var(--edge); border-top: none; }
  @media (max-width: 699px) {
    .wrap.framed { padding: 12px 12px 0; }
    .stack { height: 30px; }
  }
  .top {
    padding: 18px 20px;
    line-height: 22px;
    border-bottom: 1px solid var(--line);
    display: flex;
    justify-content: space-between;
    gap: 24px;
    font-size: 13px;
  }
  .items { display: flex; flex-wrap: wrap; gap: 4px 24px; }
  .items a { color: inherit; text-decoration: none; }
  .items a:hover { color: var(--ink-2); }
  .proj { color: var(--pc); }
  .quiet { color: var(--quiet); }
  .body { flex: 1 1 auto; padding: 18px 20px; display: flex; flex-direction: column; justify-content: flex-end; }
  .title { margin: 0; font-weight: 600; line-height: 1; letter-spacing: -0.05em; }
  .title.page { font-size: 96px; }
  .title.post { font-size: 72px; letter-spacing: -0.045em; max-width: 700px; }
  .line { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; margin-top: 14px; }
  .desc { margin: 0; font-size: 17px; color: var(--ink-2); line-height: 1.4; }
  .ext { font-size: 17px; white-space: nowrap; color: var(--ink); }

  @media (max-width: 1199px) {
    .top { padding: 16px 16px 0; border-bottom: 0; line-height: 1.4; }
    .items { gap: 4px 16px; }
    .body { padding: 48px 16px 16px; }
    .title.page { font-size: 64px; }
    .title.post { font-size: 44px; line-height: 1.02; margin-top: 0; }
    .line { flex-direction: column; align-items: flex-start; gap: 10px; }
    .desc { font-size: 16px; }
    .ext { font-size: 16px; }
  }
</style>
