---
// The left pane. Nothing selected: the projects as a grid. A project selected:
// it takes the stage as one full-width cell, the others collapse to rows
// underneath, so the change is visible at a glance. Then When, as a ruled list.
import { Image } from 'astro:assets';
import ThingCell from './ThingCell.astro';
import type { Post, Thing } from '../lib/load';

interface Props {
  things: Thing[];
  posts: Post[];
  thing?: string;
  month?: string;
}

const { things, posts, thing, month } = Astro.props;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const months = Array.from(new Set(posts.map((p) => p.data.date.slice(0, 7)))).sort().reverse();
const years = Array.from(new Set(months.map((m) => m.slice(0, 4))));
const blanks = things.length % 2;
const picked = thing ? things.find((t) => t.id === thing) : undefined;
const pickedIndex = picked ? things.indexOf(picked) + 1 : 0;
---

<h2 class="label small top">Projects I'm working on</h2>
{
  picked ? (
    <section class="picked">
      <a href="/" class="row every">
        <span class="n small"></span>
        <span class="rname">everything</span>
        <span class="rline small">all projects, the whole feed</span>
      </a>
      {things.map((t, i) =>
        t.id === picked.id ? (
          <div class="stage">
            <div class="hero">
              <div class="text">
                <div class="head">
                  <span class="n small">{String(i + 1).padStart(2, '0')}</span>
                  <span class="name" transition:name={`thing-${t.id}`}>{t.data.name}</span>
                </div>
                {t.data.line && <p class="blurb">{t.data.line}</p>}
                {t.data.try.length > 0 && (
                  <p class="try">
                    {t.data.try.map((l) => (
                      <a href={l.url}>{l.label}</a>
                    ))}
                  </p>
                )}
              </div>
              {t.data.cover && (
                <div class="pic" transition:name={`thing-${t.id}-pic`}>
                  <Image src={t.data.cover} alt={t.data.name} widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 40vw" />
                </div>
              )}
            </div>
            {t.data.screenshots.length > 0 && (
              <div class="shots">
                {t.data.screenshots.map((s) => (
                  <a href={s.src}>
                    <Image src={s} alt="" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 30vw" />
                  </a>
                ))}
              </div>
            )}
          </div>
        ) : (
          <a href={`/${t.id}`} class="row">
            <span class="n small">{String(i + 1).padStart(2, '0')}</span>
            <span class="rname" transition:name={`thing-${t.id}`}>{t.data.name}</span>
            <span class="rline small">{t.data.line}</span>
          </a>
        ),
      )}
    </section>
  ) : (
    <section class="cells">
      {things.map((t, i) => (
        <ThingCell thing={t} index={i + 1} />
      ))}
      {blanks > 0 && <div class="blank" />}
    </section>
  )
}

<section class="list">
  <h2 class="label small">When</h2>
  <a href={thing ? `/${thing}` : '/'} class:list={['line', { on: !month }]}>all time</a>
  {
    years.map((y) => (
      <div class="year">
        <a href={`/${y}`} class:list={['y', { on: y === month }]}>{y}</a>
        <span class="months">
          {months
            .filter((m) => m.startsWith(y))
            .map((m) => (
              <a href={`/${m}`} class:list={[{ on: m === month }]}>
                {MONTHS[+m.slice(5, 7) - 1]}
              </a>
            ))}
        </span>
      </div>
    ))
  }
</section>

<style>
  .cells {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: minmax(38vh, auto);
    gap: 1px;
    background: var(--line);
    border-bottom: 1px solid var(--line);
  }
  .blank { background: var(--bg); }

  /* the picked project */
  /* the expanded project: the height of a front cell */
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 40%);
    gap: 24px;
    align-items: end;
    padding: 24px var(--page-pad) 24px;
    border-bottom: 1px solid var(--line);
    min-height: 38vh;
  }
  .head { display: flex; align-items: baseline; gap: 1rem; }
  .n { color: var(--accent); }
  .name {
    font-size: clamp(2.5rem, 12cqw, 6.5rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.95;
  }
  .blurb { max-width: 40ch; margin: 0.75rem 0 0.75rem; color: var(--ink-2); }
  .try { display: flex; gap: 1rem; margin: 0; }
  .pic :global(img) { width: 100%; height: auto; display: block; }

  .shots { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 1px; background: var(--line); border-bottom: 1px solid var(--line); }
  .shots a { display: block; background: var(--bg); }

  /* collapsed projects: every row the same height, one line each */
  .row {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 10rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    height: 64px;
    padding: 0 var(--page-pad);
    align-content: center;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .rline { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .row .n { color: var(--ink-3); }
  .rname { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.01em; }
  .rline { color: var(--ink-2); }
  .row:hover .rname { text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 5px; }

  .list { padding: 20px 0 8px; }
  .label.top { padding-top: 14px; }
  .label {
    font-weight: 400;
    color: var(--ink-3);
    margin: 0;
    padding: 0 var(--page-pad) 8px;
    border-bottom: 1px solid var(--line);
  }

  .year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1rem;
    padding: 10px var(--page-pad);
    border-bottom: 1px solid var(--line);
  }
  .y { color: var(--ink-2); text-decoration: none; }
  .y:hover { text-decoration: underline; }
  .y.on { color: var(--accent); }

  .line {
    display: block;
    padding: 10px var(--page-pad);
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .line:hover { text-decoration: underline; }
  .line.on { color: var(--accent); }
  .months { display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .months a { text-decoration: none; color: var(--ink); }
  .months a.on { color: var(--accent); }
  .months a:hover { text-decoration: underline; }

  /* In the 1/3 menu the stage stacks: text, then the picture. */
  @container pane (max-width: 640px) {
    .cells { grid-template-columns: minmax(0, 1fr); grid-auto-rows: minmax(24vh, auto); }
    .blank { display: none; }
    .hero { grid-template-columns: minmax(0, 1fr); align-items: start; min-height: 0; padding-bottom: 20px; }
    .pic { max-width: 70%; }
    .row { grid-template-columns: 2.5rem minmax(0, 1fr); height: 72px; }
    .rline { grid-column: 2; }
  }

  @media (max-width: 900px) {
    .cells { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
    .blank { display: none; }
    .hero { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .row { grid-template-columns: 2.5rem minmax(0, 1fr); }
    .rline { grid-column: 2; }
  }
</style>
