---
// An open post, at reading width: the same label row as its cell (kind ·
// project, the date on the right), the title if there is one, the pictures,
// the text. A note without a title shows its text large: the note is its own
// headline. Newer / older at the end. The post keeps a minimum height so what
// follows sits well below it, even when the post is three lines.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { formatDate, laneOf } from '../lib/posts';
import type { Post } from '../lib/load';

interface Props {
  post: Post;
  names: Map<string, string>;
  colors?: Map<string, string>;
  newer?: Post;
  older?: Post;
}

const { post, names, colors = new Map(), newer, older } = Astro.props;
const { Content } = await render(post);
const offset = post.data.date.match(/(Z|[+-]\d\d:?\d\d)$/)?.[1];
const link = post.data.link || '';
const KIND = { photo: 'Photo', set: 'Set', note: 'Note', longread: 'Longread' } as const;
const lead = !post.data.title && post.kind === 'note';
---

<article class={`post kind-${post.kind}`} transition:name={`post-${post.id}`}>
  <p class="top small">
    <span class="what">
      <a href={`/${laneOf(post.kind)}`}>{KIND[post.kind]}</a>
      {
        post.things.map((id) => (
          <>
            <span class="sep"> · </span>
            <a href={`/${id}`} class:list={[{ tint: colors.has(id) }]} style={colors.has(id) ? `--c: ${colors.get(id)}` : undefined}>
              {names.get(id) ?? id}
            </a>
          </>
        ))
      }
    </span>
    <span class="when">
      <time datetime={post.when.toISOString()}>{formatDate(post.data.date)}</time>
      {offset && <span class="zone"> UTC{offset === 'Z' ? '' : offset}</span>}
    </span>
  </p>
  {post.data.title && <h1 class="title">{post.data.title}</h1>}
  {
    post.data.images.map((img) => (
      <a href={img.src} class="pic" title={`${img.width} × ${img.height}`}>
        <Image src={img} alt={post.data.title || ''} widths={[680, 1360, 2040]} sizes="(max-width: 900px) 100vw, 44vw" />
      </a>
    ))
  }
  {link && <p class:list={['link', { lead }]}><a href={link}>{link.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></p>}
  {
    post.text && (
      <div class:list={['body', { lead }]}>
        <Content />
      </div>
    )
  }
  {
    (newer || older) && (
      <p class="around small">
        {newer && <a href={`/${newer.id}`} class="newer">← newer</a>}
        {older && <a href={`/${older.id}`} class="older">older →</a>}
      </p>
    )
  }
</article>

<style>
  .post {
    display: flex;
    flex-direction: column;
    min-height: 64vh;
    padding: 28px var(--page-pad) 48px; /* the cells' padding, so the post lines up with what follows */
    max-width: calc(var(--read) + 2 * var(--page-pad));
  }

  /* the label row, as on the cell this post came from */
  .top { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin: 0 0 1.75rem; }
  .what { color: var(--ink); font-weight: 500; }
  .what a { color: inherit; text-decoration: none; }
  .what a:hover { text-decoration: underline; text-decoration-color: var(--accent-ink); text-underline-offset: 3px; }
  .what a.tint { color: color-mix(in oklab, var(--c) var(--tint-mix), #000); }
  .what a.tint:hover { text-decoration-color: currentColor; }
  .sep, .zone { color: var(--ink-3); font-weight: 400; }
  .when { color: var(--ink-3); white-space: nowrap; }

  .title {
    font-size: clamp(1.75rem, 4cqw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 1.5rem;
  }

  .pic { display: block; margin: 0 0 1.5rem; }
  .pic :global(img) { width: 100%; height: auto; }

  .link { margin: 0 0 1.5rem; font-size: 1.0625rem; }

  .body { font-size: 1.0625rem; line-height: 1.65; }
  .body :global(p) { margin: 0 0 1.25em; }
  .body :global(h1), .body :global(h2) { font-size: 1.25rem; margin: 2rem 0 0.75rem; }
  .body :global(h3) { font-size: 1.0625rem; margin: 1.5rem 0 0.5rem; }
  .body :global(img) { margin: 1.5rem 0; }
  .body :global(p:last-child) { margin-bottom: 0; }

  /* a note with no title: its text is the headline */
  .lead, .body.lead { font-size: clamp(1.375rem, 2.4cqw, 1.75rem); line-height: 1.35; letter-spacing: -0.01em; }
  .body.lead :global(p) { margin: 0 0 1em; }

  .around { display: flex; justify-content: space-between; margin: auto 0 0; padding-top: 3rem; }
  .around a { color: var(--ink-2); text-decoration: none; }
  .around a:hover { color: var(--ink); }
  .around .older { margin-left: auto; }

  @media (max-width: 900px) {
    .post { min-height: 0; }
  }
</style>
