---
// An open post, per the hand-over v2. A longread: the text across all three
// columns, a paragraph never wider than 620px, pictures full width. A photo or
// a set: the pictures across the width, the caption (columns 1–2) and older /
// newer (column 3) below.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import { KIND_LABEL } from '../lib/related';
import type { Post } from '../lib/load';

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const visual = post.data.images.length > 0;
const link = post.data.link || '';
---

{
  visual ? (
    <div class="visual">
      <div class="pics">
        {post.data.images.map((img, i) => (
          <a href={img.src} class="pic" title={`${img.width} × ${img.height}`}>
            <Image src={img} alt={post.title || `${KIND_LABEL[post.kind]} ${i + 1}`} widths={[800, 1600, 2400]} sizes="(max-width: 1199px) 100vw, calc(100vw - 400px)" />
          </a>
        ))}
      </div>
      <div class="under">
        <div class="caption">
          {link && <p><a href={link}>{link.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></p>}
          {post.text && <Content />}
        </div>
        <nav class="around">
          {older ? <a href={`/${older.id}`}>← older</a> : <span class="quiet">← older</span>}
          {newer ? <a href={`/${newer.id}`}>newer →</a> : <span class="quiet">newer →</span>}
        </nav>
      </div>
    </div>
  ) : (
    <div class="text">
      {link && <p><a href={link}>{link.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a></p>}
      {post.text && <Content />}
    </div>
  )
}

<style>
  /* the article: 18px between blocks, a paragraph never wider than 620px, a
     picture the full width (Markdoc wraps a lone picture in a paragraph) */
  .text {
    padding: 28px 20px 40px;
    font-size: 19px;
    line-height: 1.6;
  }
  .text :global(p), .text :global(ul), .text :global(ol), .text :global(blockquote) { margin: 0 0 18px; max-width: 620px; text-wrap: pretty; }
  .text :global(h2), .text :global(h3) { max-width: 620px; margin: 36px 0 18px; font-size: 24px; font-weight: 600; letter-spacing: -0.02em; line-height: 1.2; }
  .text :global(h3) { font-size: 20px; font-weight: 500; }
  .text :global(p:has(> img:only-child)) { max-width: none; }
  .text :global(img) { width: 100%; max-width: none; display: block; }
  .text :global(> :last-child) { margin-bottom: 0; }

  .pics { border-bottom: 1px solid var(--line); }
  .pic { display: block; }
  .pic :global(img) { width: 100%; height: auto; max-height: 88vh; object-fit: contain; display: block; }
  .pic + .pic { border-top: 1px solid var(--line); }
  .under { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .caption { grid-column: span 2; padding: 14px 20px; font-size: 15px; color: var(--ink-2); border-right: 1px solid var(--line); }
  .caption :global(p) { margin: 0 0 0.6em; max-width: 620px; }
  .caption :global(p:last-child) { margin: 0; }
  .around { padding: 14px 20px; display: flex; justify-content: space-between; font-size: 13px; border-right: 1px solid var(--line); }
  .around a { text-decoration: none; }
  .quiet { color: var(--quiet); }

  @media (max-width: 1199px) {
    .text { padding: 20px 16px; font-size: 18px; }
    .text :global(p), .text :global(ul), .text :global(ol), .text :global(blockquote) { margin-bottom: 16px; }
    .text :global(img) { margin: 0 -16px; width: calc(100% + 32px); }
    .under { grid-template-columns: minmax(0, 1fr); }
    .caption, .around { grid-column: auto; border-right: 0; padding: 14px 16px; }
    .caption { border-bottom: 1px solid var(--line); }
  }
</style>
