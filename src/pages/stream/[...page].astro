---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Stream from '../../components/Stream.astro';
import { loadPosts, loadThings, thingNames, PAGE_SIZE } from '../../lib/load';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await loadPosts();
  return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const things = await loadThings();
const names = thingNames(things);
---

<Base title={page.currentPage > 1 ? `Stream, page ${page.currentPage}` : 'Stream'} section="stream">
  <main class="main">
    <Stream posts={page.data} things={names} lane="all" older={page.url.next} newer={page.url.prev} />
  </main>
</Base>

<style>
  .main { padding-top: 1.5rem; }
</style>
