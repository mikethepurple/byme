---
import type { GetStaticPaths } from 'astro';
import TwoPane from '../../layouts/TwoPane.astro';
import Archive from '../../components/Archive.astro';
import Side from '../../components/Side.astro';
import { loadPosts, loadThings, thingNames, PAGE_SIZE } from '../../lib/load';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await loadPosts();
  return paginate(posts, { pageSize: PAGE_SIZE });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);
---

<TwoPane title={page.currentPage > 1 ? `Stream, page ${page.currentPage}` : 'Stream'} section="stream">
  <Archive slot="left" posts={posts} things={things} lane="all" />
  <Side slot="right" posts={page.data} things={names} lane="all" older={page.url.next} newer={page.url.prev} />
</TwoPane>
