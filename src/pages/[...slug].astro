---
// Every address but the front. Browsing (everything, a project, a kind, a
// month, a page): a grid of posts on the left, a project's head above its
// posts. Reading: the post on the left, similar posts under the navigation.
import TwoPane from '../layouts/TwoPane.astro';
import Nav from '../components/Nav.astro';
import Grid from '../components/Grid.astro';
import ProjectHead from '../components/ProjectHead.astro';
import PostView from '../components/Post.astro';
import { similar } from '../lib/related';
import { formatDate } from '../lib/posts';
import {
  loadPosts,
  loadThings,
  thingNames,
  scopePosts,
  scopeLabel,
  monthsOf,
  yearsOf,
  firstLine,
  LANES,
  PAGE_SIZE,
  type Post,
  type Thing,
  type Scope,
  type Item,
} from '../lib/load';

export const prerender = true;

type Props = ({ type: 'browse'; page?: number } & Scope) | { type: 'read'; post: Post; prev?: Post; next?: Post };

const SCOPED_MAX = 100;
const SIMILAR = 6;

export async function getStaticPaths() {
  const things = await loadThings();
  const posts = await loadPosts();
  const paths: { params: { slug: string }; props: Props }[] = [];
  const reserved = new Set<string>([...LANES, 'everything', 'page', 'rss.xml', 'micropub', 'auth', 'keystatic']);

  paths.push({ params: { slug: 'everything' }, props: { type: 'browse' } });
  for (const lane of LANES) paths.push({ params: { slug: lane }, props: { type: 'browse', lane } });
  for (const t of things) {
    if (reserved.has(t.id) || /^\d{4}-\d\d/.test(t.id)) throw new Error(`Thing slug "${t.id}" is reserved`);
    paths.push({ params: { slug: t.id }, props: { type: 'browse', thing: t.id } });
    for (const lane of LANES) paths.push({ params: { slug: `${t.id}/${lane}` }, props: { type: 'browse', thing: t.id, lane } });
  }
  // A month (2026-10) or a whole year (2026) narrows the feed the same way: by prefix.
  for (const m of [...yearsOf(posts), ...monthsOf(posts)]) {
    paths.push({ params: { slug: m }, props: { type: 'browse', month: m } });
    for (const lane of LANES) paths.push({ params: { slug: `${m}/${lane}` }, props: { type: 'browse', month: m, lane } });
  }
  for (let n = 2; (n - 1) * PAGE_SIZE < posts.length; n++) {
    paths.push({ params: { slug: `page/${n}` }, props: { type: 'browse', page: n } });
  }
  posts.forEach((post, i) => {
    // posts are newest first: prev = newer, next = older
    paths.push({ params: { slug: post.id }, props: { type: 'read', post, prev: posts[i - 1], next: posts[i + 1] } });
  });
  return paths;
}

const props = Astro.props as Props;
const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);

let title = '';
let description: string | undefined;
let image: string | undefined;
let scope: Scope = {};
let items: Item[] = [];
let older: string | undefined;
let newer: string | undefined;
let head: { thing: Thing; index: number } | undefined;
let related: { title: string; posts: Post[] } | undefined;

if (props.type === 'browse') {
  scope = { thing: props.thing, lane: props.lane, month: props.month };
  title = scopeLabel(scope, names);
  const scoped = scopePosts(posts, scope);
  let feed: Post[];
  if (props.page) {
    const n = props.page;
    feed = scoped.slice((n - 1) * PAGE_SIZE, n * PAGE_SIZE);
    title = `page ${n}`;
    newer = n === 2 ? '/everything' : `/page/${n - 1}`;
    older = n * PAGE_SIZE < scoped.length ? `/page/${n + 1}` : undefined;
  } else if (!props.thing && !props.lane && !props.month) {
    feed = scoped.slice(0, PAGE_SIZE);
    older = scoped.length > PAGE_SIZE ? '/page/2' : undefined;
  } else {
    feed = scoped.slice(0, SCOPED_MAX);
  }
  items = feed.map((post) => ({ kind: 'post', post }));
  if (props.thing) {
    const t = things.find((x) => x.id === props.thing)!;
    head = { thing: t, index: things.indexOf(t) + 1 };
    description = t.data.line || undefined;
    image = t.data.cover?.src;
  }
} else {
  const p = props.post;
  title = p.data.title || firstLine(p.plain) || `${p.kind} · ${formatDate(p.data.date)}`;
  description = p.text ? firstLine(p.plain, 160) : undefined;
  image = p.data.images[0]?.src;
  scope = { thing: p.things[0] };
  related = { title: 'Similar posts', posts: similar(p, posts, SIMILAR) };
}
---

<TwoPane title={title} description={description} image={image} type={props.type === 'read' ? 'article' : 'website'}>
  <Fragment slot="content">
    {head && <ProjectHead thing={head.thing} index={head.index} />}
    {props.type === 'browse' && <Grid items={items} names={names} />}
    {
      (older || newer) && (
        <nav class="pages small">
          {newer && <a href={newer}>← newer</a>}
          {older && <a href={older}>older →</a>}
        </nav>
      )
    }
    {props.type === 'read' && <PostView post={props.post} names={names} newer={props.prev} older={props.next} />}
  </Fragment>
  <Nav slot="side" things={things} posts={posts} scope={scope} where={props.type} related={related} />
</TwoPane>

<style>
  .pages { display: flex; justify-content: space-between; padding: 1rem var(--page-pad) 2rem; }
  .pages a { color: var(--ink-2); text-decoration: none; }
  .pages a:hover { color: var(--ink); }
</style>
