---
// Every address but the front: a narrowed feed (project, kind, month, page),
// or an open post. The screen is the same in every case.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import TwoPane from '../layouts/TwoPane.astro';
import Index from '../components/Index.astro';
import Column, { type Row } from '../components/Column.astro';
import { formatDate } from '../lib/posts';
import {
  loadPosts,
  loadThings,
  thingNames,
  scopePosts,
  scopeLabel,
  monthsOf,
  yearsOf,
  firstLine,
  LANES,
  PAGE_SIZE,
  type Post,
  type Lane,
  type Scope,
} from '../lib/load';

export const prerender = true;

type Props = ({ type: 'browse'; page?: number } & Scope) | { type: 'read'; post: Post; prev?: Post; next?: Post };

const SCOPED_MAX = 100;

export async function getStaticPaths() {
  const things = await loadThings();
  const posts = await loadPosts();
  const paths: { params: { slug: string }; props: Props }[] = [];
  const reserved = new Set<string>([...LANES, 'page', 'rss.xml', 'micropub', 'auth', 'keystatic']);

  for (const lane of LANES) paths.push({ params: { slug: lane }, props: { type: 'browse', lane } });
  for (const t of things) {
    if (reserved.has(t.id) || /^\d{4}-\d\d/.test(t.id)) throw new Error(`Thing slug "${t.id}" is reserved`);
    paths.push({ params: { slug: t.id }, props: { type: 'browse', thing: t.id } });
    for (const lane of LANES) paths.push({ params: { slug: `${t.id}/${lane}` }, props: { type: 'browse', thing: t.id, lane } });
  }
  // A month (2026-10) or a whole year (2026) narrows the feed the same way: by prefix.
  for (const m of [...yearsOf(posts), ...monthsOf(posts)]) {
    paths.push({ params: { slug: m }, props: { type: 'browse', month: m } });
    for (const lane of LANES) paths.push({ params: { slug: `${m}/${lane}` }, props: { type: 'browse', month: m, lane } });
  }
  for (let n = 2; (n - 1) * PAGE_SIZE < posts.length; n++) {
    paths.push({ params: { slug: `page/${n}` }, props: { type: 'browse', page: n } });
  }
  posts.forEach((post, i) => {
    // posts are newest first: prev = newer, next = older
    paths.push({ params: { slug: post.id }, props: { type: 'read', post, prev: posts[i - 1], next: posts[i + 1] } });
  });
  return paths;
}

const props = Astro.props as Props;
const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);

let title = '';
let description: string | undefined;
let image: string | undefined;

// What the index marks and what the feed shows.
let scope: Scope = {};
let feed: Post[] = [];
let label = 'everything';
let older: string | undefined;
let newer: string | undefined;
let rows: Row[] = [];
let Content: any = null;

if (props.type === 'browse') {
  scope = { thing: props.thing, lane: props.lane, month: props.month };
  label = scopeLabel(scope, names);
  title = label === 'everything' ? `by.erikov.me` : label;
  const scoped = scopePosts(posts, scope);
  if (props.page) {
    const n = props.page;
    feed = scoped.slice((n - 1) * PAGE_SIZE, n * PAGE_SIZE);
    title = `page ${n}`;
    newer = n === 2 ? '/' : `/page/${n - 1}`;
    older = n * PAGE_SIZE < scoped.length ? `/page/${n + 1}` : undefined;
  } else {
    feed = scoped.slice(0, SCOPED_MAX);
  }
  if (props.thing) {
    const t = things.find((x) => x.id === props.thing)!;
    description = t.data.line || undefined;
    image = t.data.cover?.src;
  }
} else {
  const p = props.post;
  title = p.data.title || firstLine(p.text) || `${p.kind} · ${formatDate(p.data.date)}`;
  description = p.text ? firstLine(p.text, 160) : undefined;
  image = p.data.images[0]?.src;
  Content = (await render(p)).Content;
  // The feed continues in the post's own project when it has one.
  scope = { thing: p.data.things[0]?.id };
  label = scope.thing ? `more in ${names.get(scope.thing) ?? scope.thing}` : 'more';
  feed = scopePosts(posts, scope)
    .filter((x) => x.id !== p.id)
    .slice(0, SCOPED_MAX);

  const offset = p.data.date.match(/(Z|[+-]\d\d:?\d\d)$/)?.[1];
  const lane = p.kind === 'photo' || p.kind === 'set' ? 'photos' : p.kind === 'longread' ? 'longreads' : 'notes';
  rows = [
    { key: 'posted', value: `${formatDate(p.data.date)}${offset ? ` (UTC${offset === 'Z' ? '' : offset})` : ''}` },
    { key: 'kind', value: p.kind, href: `/${lane}` },
  ];
  if (p.data.things.length > 0) {
    rows.push({ key: 'projects', links: p.data.things.map((t) => ({ label: names.get(t.id) ?? t.id, href: `/${t.id}` })) });
  }
  if (p.data.images.length > 0) {
    rows.push({
      key: p.data.images.length === 1 ? 'original' : 'originals',
      links: p.data.images.map((img, i) => ({
        label: `${img.width}×${img.height}${p.data.images.length > 1 ? ` (${i + 1})` : ''}`,
        href: img.src,
      })),
    });
  }
  if (p.data.link) rows.push({ key: 'link', value: p.data.link.replace(/^https?:\/\//, ''), href: p.data.link });
  const around: { label: string; href: string }[] = [];
  if (props.prev) around.push({ label: 'newer', href: `/${props.prev.id}` });
  if (props.next) around.push({ label: 'older', href: `/${props.next.id}` });
  if (around.length) rows.push({ key: 'around', links: around });
  rows.push({ key: 'address', value: `by.erikov.me/${p.id}`, href: `/${p.id}` });
}

// Where the kind tabs live: within the project or month in force.
const base = scope.thing ? `/${scope.thing}` : scope.month ? `/${scope.month}` : '';
---

<TwoPane title={title} description={description} image={image} type={props.type === 'read' ? 'article' : 'website'} mode={props.type === 'read' ? 'read' : 'browse'}>
  <Index slot="left" things={things} posts={posts} thing={scope.thing} month={scope.month} />
  <Column slot="right" label={label} base={base} lane={scope.lane} posts={feed} things={names} older={older} newer={newer} rows={rows}>
    {
      props.type === 'read' && (
        <article class="open" transition:name={`post-${props.post.id}`}>
          {props.post.data.images.map((img) => (
            <a href={img.src} class="full">
              <Image src={img} alt={props.post.data.title || ''} widths={[680, 1360, 2040]} sizes="(max-width: 900px) 100vw, 50vw" />
            </a>
          ))}
          {props.post.data.title && <h1>{props.post.data.title}</h1>}
          {props.post.data.link && (
            <p class="link">
              <a href={props.post.data.link}>{props.post.data.link.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>
            </p>
          )}
          {props.post.text && (
            <div class="body">
              <Content />
            </div>
          )}
        </article>
      )
    }
  </Column>
</TwoPane>

<style>
  .open {
    padding: 20px var(--page-pad) 24px;
    border-bottom: 1px solid var(--line);
  }
  .open .full { display: block; margin: 0 0 1rem; }
  .open h1 { font-size: 1.5rem; margin: 0.5rem 0 1rem; }
  .open .body { font-size: 1.05rem; line-height: 1.65; max-width: var(--read); }
  .open .body :global(h2) { margin-top: 2rem; }
  .open .body :global(img) { margin: 1rem 0; }
  .open .link { margin: 0 0 1rem; }
</style>
