---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import TwoPane from '../layouts/TwoPane.astro';
import Archive from '../components/Archive.astro';
import Side from '../components/Side.astro';
import { formatDate, wallParts } from '../lib/posts';
import {
  loadPosts,
  loadThings,
  thingNames,
  postsOf,
  postsIn,
  firstLine,
  LANES,
  PAGE_SIZE,
  type Post,
  type Thing,
  type Lane,
} from '../lib/load';

export const prerender = true;

type Props =
  | { type: 'lane'; lane: Lane }
  | { type: 'thing'; thing: Thing }
  | { type: 'post'; post: Post; prev?: Post; next?: Post };

export async function getStaticPaths() {
  const things = await loadThings();
  const posts = await loadPosts();
  const paths: { params: { slug: string }; props: Props }[] = [];

  for (const lane of LANES) paths.push({ params: { slug: lane }, props: { type: 'lane', lane } });
  for (const thing of things) {
    if ((LANES as readonly string[]).includes(thing.id)) throw new Error(`Thing slug "${thing.id}" is reserved for a lane`);
    paths.push({ params: { slug: thing.id }, props: { type: 'thing', thing } });
  }
  posts.forEach((post, i) => {
    // posts are newest first: prev = newer, next = older
    paths.push({ params: { slug: post.id }, props: { type: 'post', post, prev: posts[i - 1], next: posts[i + 1] } });
  });
  return paths;
}

const props = Astro.props as Props;
const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);

let title = '';
let description: string | undefined;
let image: string | undefined;
let Content: any = null;

if (props.type === 'lane') {
  title = props.lane;
} else if (props.type === 'thing') {
  title = props.thing.data.name;
  description = props.thing.data.line || undefined;
  image = props.thing.data.cover?.src;
} else {
  const p = props.post;
  title = p.data.title || firstLine(p.text) || `${p.kind} · ${formatDate(p.data.date)}`;
  description = p.text ? firstLine(p.text, 160) : undefined;
  image = p.data.images[0]?.src;
  Content = (await render(p)).Content;
}

// The right column of a post: its facts, then its siblings in the same projects.
function postRows(p: Post, prev?: Post, next?: Post) {
  const offset = p.data.date.match(/(Z|[+-]\d\d:?\d\d)$/)?.[1];
  const w = wallParts(p.data.date);
  const rows = [
    { key: 'posted', value: `${formatDate(p.data.date)}${offset ? ` (${offset === 'Z' ? 'UTC' : 'UTC' + offset})` : ''}` },
    { key: 'kind', value: p.kind, href: `/${p.kind === 'photo' || p.kind === 'set' ? 'photos' : p.kind === 'longread' ? 'longreads' : 'notes'}` },
  ];
  if (p.data.things.length > 0) {
    rows.push({ key: 'projects', value: '', links: p.data.things.map((t) => ({ label: names.get(t.id) ?? t.id, href: `/${t.id}` })) } as any);
  }
  if (p.data.images.length > 0) {
    rows.push({
      key: p.data.images.length === 1 ? 'original' : 'originals',
      value: '',
      links: p.data.images.map((img, i) => ({ label: `${img.width}×${img.height}${p.data.images.length > 1 ? ` (${i + 1})` : ''}`, href: img.src })),
    } as any);
  }
  if (p.data.link) rows.push({ key: 'link', value: p.data.link.replace(/^https?:\/\//, ''), href: p.data.link });
  const around = [] as { label: string; href: string }[];
  if (prev) around.push({ label: 'newer', href: `/${prev.id}` });
  if (next) around.push({ label: 'older', href: `/${next.id}` });
  if (around.length) rows.push({ key: 'around', value: '', links: around } as any);
  rows.push({ key: 'address', value: `by.erikov.me/${p.id}`, href: `/${p.id}` });
  void w;
  return rows;
}

function siblings(p: Post): Post[] {
  const ids = new Set(p.data.things.map((t) => t.id));
  if (ids.size === 0) return [];
  return posts.filter((x) => x.id !== p.id && x.data.things.some((t) => ids.has(t.id))).slice(0, 6);
}
---

{
  props.type === 'lane' && (
    <TwoPane title={title} section="stream">
      <Archive slot="left" posts={posts} things={things} lane={props.lane} />
      <Side slot="right" posts={postsIn(posts, props.lane).slice(0, PAGE_SIZE)} things={names} lane={props.lane} />
    </TwoPane>
  )
}

{
  props.type === 'thing' && (
    <TwoPane title={title} description={description} image={image} section="projects">
      <div slot="left" class="read thing">
        <h1>{props.thing.data.name}</h1>
        {props.thing.data.line && <p class="line">{props.thing.data.line}</p>}
        {props.thing.data.screenshots.length > 0 && (
          <div class="shots">
            {props.thing.data.screenshots.map((s) => (
              <a href={s.src}>
                <Image src={s} alt="" widths={[680, 1360]} sizes="(max-width: 900px) 100vw, 60vw" />
              </a>
            ))}
          </div>
        )}
      </div>
      <Side
        slot="right"
        posts={postsOf(posts, props.thing.id)}
        things={names}
        lane="all"
        rows={props.thing.data.try.map((t) => ({ key: 'try', value: t.label, href: t.url }))}
      />
    </TwoPane>
  )
}

{
  props.type === 'post' && (
    <TwoPane title={title} description={description} image={image} type="article" section="stream">
      <article slot="left" class="read post">
        {props.post.data.images.map((img) => (
          <a href={img.src} class="full">
            <Image src={img} alt={props.post.data.title || ''} widths={[680, 1360, 2040]} sizes="(max-width: 900px) 100vw, 680px" />
          </a>
        ))}
        {props.post.data.title && <h1>{props.post.data.title}</h1>}
        {props.post.data.link && (
          <p class="link">
            <a href={props.post.data.link}>{props.post.data.link.replace(/^https?:\/\//, '').replace(/\/$/, '')}</a>
          </p>
        )}
        {props.post.text && (
          <div class="body">
            <Content />
          </div>
        )}
      </article>
      <Side
        slot="right"
        posts={posts.slice(0, PAGE_SIZE)}
        things={names}
        lane="all"
        current={props.post.id}
        rows={postRows(props.post, props.prev, props.next)}
        related={{
          label: `Also in ${props.post.data.things.map((t) => names.get(t.id) ?? t.id).join(', ')}`,
          posts: siblings(props.post),
        }}
      />
    </TwoPane>
  )
}

<style>
  .read { padding: 20px var(--page-pad) 3rem; max-width: calc(var(--read) + 2 * var(--page-pad)); }

  .thing h1 {
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 0.95;
    margin: 0.5rem 0 0.75rem;
  }
  .line { color: var(--ink-2); margin: 0 0 1.5rem; }
  .shots { display: grid; gap: 12px; }
  .shots a { display: block; }

  .post .full { display: block; margin: 0 0 1rem; }
  .post h1 { font-size: 1.5rem; margin: 0.5rem 0 1rem; }
  .post .body { font-size: 1.05rem; line-height: 1.65; }
  .post .body :global(h2) { margin-top: 2rem; }
  .post .body :global(img) { margin: 1rem 0; }
  .post .link { margin: 0 0 1rem; }
</style>
