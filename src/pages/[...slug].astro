---
// Every address but the front and about. Browsing (everything, a project,
// misc, a kind, a month, a page): a head when a project or misc is in force,
// then the grid. Reading: the post's head, then the post; "More in {project}"
// in the menu column on desktop, after the article under 1200px.
import TwoPane from '../layouts/TwoPane.astro';
import Nav from '../components/Nav.astro';
import Grid from '../components/Grid.astro';
import Head from '../components/Head.astro';
import More from '../components/More.astro';
import PostView from '../components/Post.astro';
import { KIND_LABEL, MISC, dateRange, excerpt, projectOf, readMinutes, titleOf } from '../lib/related';
import { formatDate } from '../lib/posts';
import {
  loadPosts,
  loadThings,
  thingNames,
  thingHues,
  scopePosts,
  scopeLabel,
  monthsOf,
  yearsOf,
  LANES,
  PAGE_SIZE,
  MISC_HUE,
  type Hue,
  type Post,
  type Scope,
} from '../lib/load';

export const prerender = true;

type Props = ({ type: 'browse'; page?: number } & Scope) | { type: 'read'; post: Post; prev?: Post; next?: Post };

export async function getStaticPaths() {
  const things = await loadThings();
  const posts = await loadPosts();
  const paths: { params: { slug: string }; props: Props }[] = [];
  const reserved = new Set<string>([...LANES, 'everything', 'page', 'about', MISC, 'rss.xml', 'micropub', 'auth', 'keystatic']);

  paths.push({ params: { slug: 'everything' }, props: { type: 'browse' } });
  // Every combination of project × when × kind has an address:
  // /<project>/<month>/<kind>, each part optional. A month (2026-10) or a whole
  // year (2026) narrows the same way, by prefix. misc is the project of none.
  const whens = [...yearsOf(posts), ...monthsOf(posts)];
  for (const t of things) if (reserved.has(t.id) || /^\d{4}-\d\d/.test(t.id)) throw new Error(`Thing slug "${t.id}" is reserved`);
  for (const thing of [undefined, ...things.map((t) => t.id), MISC]) {
    for (const month of [undefined, ...whens]) {
      for (const lane of [undefined, ...LANES]) {
        const slug = [thing, month, lane].filter(Boolean).join('/');
        if (!slug) continue; // that is /everything
        paths.push({ params: { slug }, props: { type: 'browse', thing, month, lane } });
      }
    }
  }
  for (let n = 2; (n - 1) * PAGE_SIZE < posts.length; n++) {
    paths.push({ params: { slug: `page/${n}` }, props: { type: 'browse', page: n } });
  }
  posts.forEach((post, i) => {
    // posts are newest first: prev = newer, next = older
    paths.push({ params: { slug: post.id }, props: { type: 'read', post, prev: posts[i - 1], next: posts[i + 1] } });
  });
  return paths;
}

const props = Astro.props as Props;
const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);
const hues = thingHues(things);

const ofProject = (id: string) => posts.filter((p) => projectOf(p) === id);
const nameOf = (id: string) => (id === MISC ? 'Misc' : (names.get(id) ?? id));
const hueOf = (id: string): Hue | undefined => (id === MISC ? MISC_HUE : hues.get(id));
const kindsLine = (ps: Post[]) => {
  const n: Record<string, number> = {};
  for (const p of ps) n[p.kind] = (n[p.kind] ?? 0) + 1;
  return (['photo', 'set', 'note', 'longread'] as const)
    .filter((k) => n[k])
    .map((k) => `${n[k]} ${KIND_LABEL[k].toLowerCase()}${n[k] > 1 ? 's' : ''}`)
    .join(' · ');
};

let title = '';
let description: string | undefined;
let image: string | undefined;
let scope: Scope = {};
let scoped: Post[] = posts;
let forKinds: Post[] = posts; // the kind row ignores its own filter: project and time only
let feed: Post[] = [];
let older: string | undefined;
let newer: string | undefined;
let hue: Hue | undefined;
let filterLabel = 'filter';

if (props.type === 'browse') {
  scope = { thing: props.thing, lane: props.lane, month: props.month };
  title = scopeLabel(scope, names).replace(MISC, 'Misc');
  const inProject = props.thing === MISC ? ofProject(MISC) : posts;
  const without = props.thing === MISC ? {} : { thing: props.thing };
  forKinds = scopePosts(inProject, { ...without, month: props.month });
  scoped = scopePosts(forKinds, { lane: props.lane });
  if (props.page) {
    const n = props.page;
    feed = scoped.slice((n - 1) * PAGE_SIZE, n * PAGE_SIZE);
    title = `page ${n}`;
    newer = n === 2 ? '/' : `/page/${n - 1}`; // page 1 is the front
    older = n * PAGE_SIZE < scoped.length ? `/page/${n + 1}` : undefined;
  } else {
    feed = scoped.slice(0, PAGE_SIZE);
    older = scoped.length > PAGE_SIZE ? `/page/2` : undefined;
  }
  if (props.thing) {
    hue = hueOf(props.thing);
    filterLabel = `filter: ${nameOf(props.thing)}`;
    const t = things.find((x) => x.id === props.thing);
    description = props.thing === MISC ? "Posts that don't belong to a project." : t?.data.line || undefined;
    image = t?.data.cover?.src;
  } else if (props.lane || props.month) {
    filterLabel = `filter: ${title}`;
  }
} else {
  const p = props.post;
  title = titleOf(p, 80);
  description = p.text ? excerpt(p.plain, 160) : undefined;
  image = p.data.images[0]?.src;
  const proj = projectOf(p);
  scope = { thing: proj };
  hue = hueOf(proj);
  filterLabel = `filter: ${nameOf(proj)}`;
}

// The head of a project page: the project's facts; of a post: its facts.
const headThing = props.type === 'browse' && props.thing ? props.thing : undefined;
const theirs = headThing ? ofProject(headThing) : [];
const thingIndex = headThing && headThing !== MISC ? things.findIndex((t) => t.id === headThing) + 1 : 0;
const thingTry = headThing && headThing !== MISC ? things.find((t) => t.id === headThing)?.data.try[0] : undefined;

const post = props.type === 'read' ? props.post : undefined;
const postProj = post ? projectOf(post) : '';
const postMore = post ? ofProject(postProj).filter((x) => x.id !== post.id) : [];
// An untitled post whose whole text is one short line: that line is its title, and nothing repeats below.
const postLead = post && !post.title && post.plain && !post.plain.includes('\n') && post.plain.length <= 140 ? post.plain : '';
const postTitle = post ? postLead || post.title || (post.plain ? titleOf(post, 80) : undefined) : undefined;
const offset = post?.data.date.match(/(Z|[+-]\d\d:?\d\d)$/)?.[1];
---

<TwoPane title={title} description={description} image={image} type={props.type === 'read' ? 'article' : 'website'} hue={hue} filterLabel={filterLabel} headed={!!headThing || !!post} shortHead={!!post && !postTitle}>
  {
    headThing && (
      <Head
        slot="head"
        left={[
          { text: headThing === MISC ? 'Misc' : 'Project' },
          { text: theirs.length ? `${theirs.length} post${theirs.length > 1 ? 's' : ''}` : 'No posts yet', quiet: true },
          ...(theirs.length ? [{ text: kindsLine(theirs), quiet: true }, { text: dateRange(theirs), quiet: true }] : []),
        ]}
        right={thingIndex ? { text: String(thingIndex).padStart(2, '0'), hue: hueOf(headThing) } : undefined}
        title={nameOf(headThing)}
        description={description}
        link={thingTry ? { label: thingTry.label, url: thingTry.url } : undefined}
        transitionName={headThing === MISC ? undefined : `thing-${headThing}`}
      />
    )
  }
  {
    post && (
      <Head
        slot="head"
        left={[
          { text: KIND_LABEL[post.kind] },
          { text: nameOf(postProj), href: `/${postProj}`, hue: hueOf(postProj) },
          ...(post.kind === 'longread' ? [{ text: `${readMinutes(post.plain)} min read`, quiet: true }] : []),
        ]}
        right={{ text: `${formatDate(post.data.date)}${offset ? ` UTC${offset === 'Z' ? '' : offset}` : ''}` }}
        title={postTitle}
        size="post"
        transitionName={`post-${post.id}`}
      />
    )
  }
  <Fragment slot="content">
    {
      props.type === 'browse' && (
        <>
          <Grid posts={feed} names={names} hues={hues} showProject={!headThing} />
          {(older || newer) && (
            <nav class="pages">
              {newer && <a href={newer}>← newer</a>}
              {older && <a href={older}>older →</a>}
            </nav>
          )}
        </>
      )
    }
    {
      post && (
        <>
          <PostView post={postLead ? ({ ...post, text: '' } as Post) : post} newer={props.type === 'read' ? props.prev : undefined} older={props.type === 'read' ? props.next : undefined} />
          {!post.data.images.length && (
            <div class="more-narrow">
              <More more={postMore} href={`/${postProj}`} projName={nameOf(postProj)} hue={hueOf(postProj)} newer={props.type === 'read' ? props.prev : undefined} older={props.type === 'read' ? props.next : undefined} />
            </div>
          )}
        </>
      )
    }
  </Fragment>
  <Nav slot="side" things={things} posts={posts} scoped={props.type === 'read' ? posts : forKinds} scope={scope} hues={hues} where={props.type === 'read' ? 'post' : 'browse'}>
    {
      post && !post.data.images.length && (
        <div class="more-wide">
          <More more={postMore} href={`/${postProj}`} projName={nameOf(postProj)} hue={hueOf(postProj)} newer={props.type === 'read' ? props.prev : undefined} older={props.type === 'read' ? props.next : undefined} />
        </div>
      )
    }
  </Nav>
</TwoPane>

<style>
  .pages { display: flex; justify-content: space-between; padding: 14px 20px; font-size: 13px; }
  .pages a { text-decoration: none; }
  .more-narrow { display: none; }
  @media (max-width: 1199px) {
    .more-wide { display: none; }
    .more-narrow { display: block; }
  }
</style>
