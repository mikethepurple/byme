---
import Base from '../layouts/Base.astro';
import ThingCell from '../components/ThingCell.astro';
import Stream from '../components/Stream.astro';
import { loadPosts, loadThings, thingNames, PAGE_SIZE } from '../lib/load';

export const prerender = true;

const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);
// The grid keeps its 2-up rhythm: with an odd number of things the last cell stays empty.
const blanks = things.length % 2;
---

<Base title="by.erikov.me" section="projects" wide>
  <main class="front">
    <section class="grid">
      {things.map((t, i) => <ThingCell thing={t} index={i + 1} />)}
      {blanks > 0 && <div class="blank" />}
    </section>

    <aside class="side">
      <Stream posts={posts.slice(0, PAGE_SIZE)} things={names} lane="all" older={posts.length > PAGE_SIZE ? '/stream/2' : undefined} />
    </aside>
  </main>
</Base>

<style>
  /* Two panes under the header, each the full height of the window, each
     scrolling on its own with no visible scrollbar. Narrow screens fall back
     to one normal page: grid, then stream. */
  .front {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    gap: 1px;
    background: var(--line);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: minmax(40vh, 1fr);
    gap: 1px;
    background: var(--line);
    align-content: stretch;
  }

  .blank { background: var(--bg); }

  .side {
    background: var(--bg);
    padding: 20px var(--page-pad) 2rem;
  }

  .side :global(.stream) { max-width: none; }

  @media (min-width: 901px) {
    :global(html), :global(body.app) { height: 100%; }
    :global(body.app) {
      display: flex;
      flex-direction: column;
      height: 100dvh;
      overflow: hidden;
    }
    :global(body.app > header) { flex: none; }
    .front { flex: 1 1 auto; min-height: 0; }
    .grid, .side {
      height: 100%;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .grid::-webkit-scrollbar, .side::-webkit-scrollbar { display: none; }
  }

  @media (max-width: 900px) {
    .front { grid-template-columns: minmax(0, 1fr); border-bottom: 1px solid var(--line); }
    .grid { grid-template-columns: minmax(0, 1fr); grid-auto-rows: auto; }
    .blank { display: none; }
  }
</style>
