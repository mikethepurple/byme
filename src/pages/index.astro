---
// The front: a grid of the projects, whatever is pinned and the latest posts;
// the navigation on the right.
import TwoPane from '../layouts/TwoPane.astro';
import Nav from '../components/Nav.astro';
import Grid from '../components/Grid.astro';
import { frontCells } from '../lib/related';
import { loadPosts, loadThings, thingNames, thingColors, type Item } from '../lib/load';

export const prerender = true;

const LATEST = 6; // latest posts in the grid after the projects and the pinned ones

const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);
const colors = thingColors(things);
const items: Item[] = frontCells(things, posts, LATEST).map((c) =>
  c.kind === 'thing' ? { kind: 'thing', thing: c.thing, index: things.indexOf(c.thing) + 1 } : { kind: 'post', post: c.post },
);
---

<TwoPane title="by.erikov.me">
  <Grid slot="content" items={items} names={names} colors={colors} />
  <Nav slot="side" things={things} posts={posts} where="front" />
</TwoPane>
