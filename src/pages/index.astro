---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ThingTile from '../components/ThingTile.astro';
import Stream from '../components/Stream.astro';
import { loadPosts, loadThings, thingNames, PAGE_SIZE } from '../lib/load';

export const prerender = true;

const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);
---

<Base title="by.erikov.me">
  <Header />

  <main class="front">
    <section class="things">
      {things.map((t) => <ThingTile thing={t} />)}
    </section>

    <Stream posts={posts.slice(0, PAGE_SIZE)} things={names} lane="all" older={posts.length > PAGE_SIZE ? '/stream/2' : undefined} />
  </main>

  <Footer />
</Base>

<style>
  .front {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, var(--col));
    gap: 48px;
    align-items: start;
  }

  .things {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  @media (max-width: 900px) {
    .front { grid-template-columns: minmax(0, 1fr); gap: 40px; }
    .things { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  }
</style>
