---
// The front: one grid — the projects first, then the latest posts (pinned
// first); the navigation on the right.
import TwoPane from '../layouts/TwoPane.astro';
import Nav from '../components/Nav.astro';
import Grid from '../components/Grid.astro';
import { frontCells } from '../lib/related';
import { loadPosts, loadThings, thingNames, thingColors } from '../lib/load';

export const prerender = true;

const LATEST = 6; // latest posts after the pinned ones

const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);
const colors = thingColors(things);
const latest = frontCells(things, posts, LATEST).flatMap((c) => (c.kind === 'post' ? [c.post] : []));
---

<TwoPane title="by.erikov.me">
  <Grid slot="content" things={things} posts={latest} names={names} colors={colors} />
  <Nav slot="side" things={things} posts={posts} where="front" />
</TwoPane>
