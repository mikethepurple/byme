---
import TwoPane from '../layouts/TwoPane.astro';
import Index from '../components/Index.astro';
import Column from '../components/Column.astro';
import { loadPosts, loadThings, thingNames, PAGE_SIZE } from '../lib/load';

export const prerender = true;

const things = await loadThings();
const posts = await loadPosts();
const names = thingNames(things);
---

<TwoPane title="by.erikov.me">
  <Index slot="left" things={things} posts={posts} />
  <Column
    slot="right"
    label="everything"
    base=""
    posts={posts.slice(0, PAGE_SIZE)}
    things={names}
    older={posts.length > PAGE_SIZE ? '/page/2' : undefined}
  />
</TwoPane>
