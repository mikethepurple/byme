---
// About, per the hand-over (screens 13, 14): the misc header layout, no frame
// or stack (it isn't a project); then a grid of blocks — the portrait, Now,
// and Elsewhere (a ledger of links). Everything is edited in Keystatic → About.
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import TwoPane from '../layouts/TwoPane.astro';
import Nav from '../components/Nav.astro';
import Head from '../components/Head.astro';
import { loadPosts, loadThings, thingHues } from '../lib/load';

export const prerender = true;

const about = (await getEntry('about', 'about'))!.data;
const things = await loadThings();
const posts = await loadPosts();
const hues = thingHues(things);
const links = [
  ...(about.email ? [{ label: 'email', url: `mailto:${about.email}`, text: about.email }] : []),
  ...about.elsewhere.map((l) => ({ label: l.label, url: l.url, text: 'link' })),
  { label: 'rss', url: '/rss.xml', text: 'link' },
];
---

<TwoPane title="About" description={about.bio} image={about.portrait?.src}>
  <Head slot="head" left={[{ text: 'About' }]} title="About" description={about.bio} />
  <div slot="content" class="blocks">
    {
      about.portrait && (
        <div class="block photo">
          <div class="k">Photo</div>
          <div class="pic"><Image src={about.portrait} alt={about.name} widths={[480, 960]} sizes="(max-width: 699px) 100vw, (max-width: 1199px) 50vw, 30vw" /></div>
        </div>
      )
    }
    {
      about.now && (
        <div class="block">
          <div class="k">Now</div>
          <div class="now">{about.now}</div>
        </div>
      )
    }
    <div class="block">
      <div class="k">Elsewhere</div>
      <div class="ledger">
        {links.map((l) => (
          <div class="lrow">
            <span class="quiet">{l.label}</span>
            <a href={l.url}>{l.text} ↗</a>
          </div>
        ))}
      </div>
    </div>
  </div>
  <Nav slot="side" things={things} posts={posts} hues={hues} where="about" />
</TwoPane>

<style>
  .blocks { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-content: start; }
  .block {
    height: var(--cell);
    box-sizing: border-box;
    padding: 18px 20px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }
  .k { font-size: 13px; }
  .pic { flex: 1 1 auto; min-height: 0; }
  .pic :global(img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .now { font-size: 20px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.3; }
  .ledger { display: flex; flex-direction: column; border-top: 1px solid var(--ink); }
  .lrow { display: flex; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 13px; line-height: 16px; }
  .lrow a { color: var(--ink); }
  .quiet { color: var(--quiet); }
  @media (max-width: 1199px) { .blocks { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 699px) { .blocks { grid-template-columns: minmax(0, 1fr); } }
</style>
