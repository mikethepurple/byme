---
// The shell, per the hand-over. From 1200px: the content on the left, the
// 400px menu on the right. A page with a head (a project, a post, about) puts
// the head and the menu on one grid row, so their hairlines meet, and the
// grid under the head; the right column continues empty below the menu.
// Under 1200px: a top bar (logo · about · filter); "filter" opens the menu as
// a full-screen sheet, by address (#filter), so no script is needed.
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  strip?: string; // a 6px top border in this colour (a project's, misc, about)
  filterLabel?: string; // the top bar's "filter" link, e.g. "filter: Ada"
}

const { title, description, image, type, strip, filterLabel = 'filter' } = Astro.props;
const hasHead = Astro.slots.has('head');
---

<Base title={title} description={description} image={image} type={type}>
  <div class:list={['shell', { headed: hasHead }]} style={strip ? `--strip: ${strip}` : undefined}>
    <header class="bar">
      <a href="/" class="brand"><span class="dot"></span>by.erikov.me</a>
      <a href="/about" class="about">about</a>
      <a href="#filter" class="filter">{filterLabel}</a>
    </header>
    {hasHead && <div class="head"><slot name="head" /></div>}
    <aside class="menu" id="filter">
      <div class="sheet-bar">
        <a href="/" class="brand"><span class="dot"></span>by.erikov.me</a>
        <a href="#" class="filter">close</a>
      </div>
      <slot name="side" />
    </aside>
    <main class="content">
      <slot name="content" />
    </main>
    {hasHead && <div class="side-rest"></div>}
  </div>
</Base>

<style>
  .shell {
    min-height: 100dvh;
    border-top: 6px solid var(--strip, transparent);
    display: grid;
    grid-template-columns: minmax(0, 1fr) 400px;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'head menu'
      'content rest';
  }
  .shell:not(.headed) {
    grid-template-rows: 1fr;
    grid-template-areas: 'content menu';
  }

  .bar { display: none; }
  .head { grid-area: head; border-bottom: 1px solid var(--line); min-width: 0; }
  .menu { grid-area: menu; border-left: 1px solid var(--line); display: flex; flex-direction: column; min-width: 0; }
  .content { grid-area: content; min-width: 0; container: pane / inline-size; }
  .side-rest { grid-area: rest; border-left: 1px solid var(--line); }

  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); font-size: 18px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--accent); flex: none; }
  .sheet-bar { display: none; }
  .filter { font-size: 17px; color: var(--ink); padding: 12px 0; text-decoration: underline; text-underline-offset: 4px; }
  .about { font-size: 17px; color: var(--ink-2); text-decoration: none; margin-left: auto; margin-right: 20px; padding: 12px 0; }

  @media (max-width: 1199px) {
    .shell, .shell:not(.headed) {
      display: flex;
      flex-direction: column;
    }
    .bar {
      display: flex;
      align-items: center;
      height: 58px;
      flex: none;
      padding: 0 var(--page-pad);
      border-bottom: 1px solid var(--line);
    }
    .side-rest { display: none; }
    .menu {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 10;
      background: var(--bg);
      border-left: 0;
      overflow-y: auto;
    }
    .menu:target { display: flex; }
    .sheet-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 58px;
      flex: none;
      padding: 0 var(--page-pad);
      border-bottom: 1px solid var(--line);
    }
  }
  @media (max-width: 699px) {
    .bar, .sheet-bar { height: 56px; }
    .brand { font-size: 17px; }
  }
</style>
