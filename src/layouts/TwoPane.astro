---
// One screen for the whole site: the index on the left (never changes), the
// feed on the right (narrows to what you picked). Both panes are the full
// height of the window and scroll on their own, no visible scrollbar; narrow
// screens stack them. `mode="read"` (a post is open) splits the panes 1:1 and
// puts the right pane first on narrow screens.
import Base from './Base.astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  mode?: 'browse' | 'read';
  split?: 'front' | 'feed'; // front: menu 2/3, feed 1/3; feed: menu 1/3, feed 2/3
}

const { title, description, image, type, mode = 'browse', split = 'feed' } = Astro.props;
---

<Base title={title} description={description} image={image} type={type} split={split} wide>
  <main class:list={['panes', mode, split]}>
    <section class="pane left">
      <slot name="left" />
    </section>
    <aside class="pane right">
      <div class="column" transition:name="feed">
        <slot name="right" />
      </div>
    </aside>
  </main>
</Base>

<style>
  .panes {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: 1px;
    background: var(--line);
  }
  .panes.front { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }

  .pane { background: var(--bg); container-type: inline-size; }


  @media (min-width: 901px) {
    :global(html), :global(body.app) { height: 100%; }
    :global(body.app) {
      display: flex;
      flex-direction: column;
      height: 100dvh;
      overflow: hidden;
    }
    :global(body.app > header) { flex: none; }
    .panes { flex: 1 1 auto; min-height: 0; }
    .pane {
      height: 100%;
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: none;
    }
    .pane::-webkit-scrollbar { display: none; }
  }

  @media (max-width: 900px) {
    .panes { grid-template-columns: minmax(0, 1fr); border-bottom: 1px solid var(--line); }
    .panes.read .right { order: -1; }
  }
</style>
