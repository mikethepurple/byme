---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  image?: string; // absolute or site-relative URL of the OG image
  type?: 'website' | 'article';
  split?: 'front' | 'feed';
  feed?: { label?: string; root?: string; base?: string; allHref?: string; lane?: any };
  wide?: boolean; // content runs edge to edge (the front grid)
}

const siteTitle = 'by.erikov.me';
const {
  title,
  description = 'Misha Erikov. Things I make, dropped here as they happen.',
  image,
  type = 'website',
  split = 'feed',
  feed = {},
  wide = false,
} = Astro.props;
const fullTitle = title === siteTitle ? title : `${title} — ${siteTitle}`;
const ogImage = image ? new URL(image, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#0e0e0e" media="(prefers-color-scheme: dark)" />
  <meta name="theme-color" content="#f2f1ee" media="(prefers-color-scheme: light)" />
  <script is:inline>
    // Theme: follows the system unless chosen. ?theme=light|dark or the toggle
    // chooses; the choice is remembered in this browser and re-applied after
    // every in-place navigation.
    (function () {
      var KEY = 'theme';
      // ?theme= is read once, then dropped from the address so the toggle wins afterwards.
      try {
        var q = new URLSearchParams(location.search).get('theme');
        if (q === 'light' || q === 'dark') {
          localStorage.setItem(KEY, q);
          var u = new URL(location.href);
          u.searchParams.delete('theme');
          history.replaceState(null, '', u.pathname + u.search + u.hash);
        }
      } catch (e) {}
      function chosen() {
        try { return localStorage.getItem(KEY); } catch (e) { return null; }
      }
      function isDark() {
        var t = document.documentElement.dataset.theme;
        return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      }
      function apply() {
        var t = chosen();
        if (t) document.documentElement.dataset.theme = t;
        else delete document.documentElement.dataset.theme;
        var label = isDark() ? 'light' : 'dark';
        document.querySelectorAll('.theme-toggle').forEach(function (b) { b.textContent = label; });
      }
      apply();
      document.addEventListener('click', function (e) {
        var b = e.target && e.target.closest && e.target.closest('.theme-toggle');
        if (!b) return;
        e.preventDefault();
        try { localStorage.setItem(KEY, isDark() ? 'light' : 'dark'); } catch (err) {}
        apply();
      });
      document.addEventListener('astro:after-swap', apply);
      document.addEventListener('astro:page-load', apply);
    })();
  </script>
  <title>{fullTitle}</title>
  <ClientRouter />
  <meta name="description" content={description} />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={Astro.url.href} />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet" />

  <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
  <link rel="micropub" href="https://by.erikov.me/micropub" />

  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='40' fill='%23ffb424'/></svg>" />
</head>
<body class:list={[{ app: wide }]}>
  <Header split={split} {...feed} />
  {wide ? <slot /> : <div class="page"><slot /></div>}
  {!wide && <Footer />}
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
